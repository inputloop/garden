#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 the Larder software contributors
#
# larder-open -- run ONE named first-run action. GENERATED by gen.sh from
# recipes.conf; do not edit, change the recipe.
# A first-run link carries a NAME, never a command: larder://library picks the
# "library" arm below and nothing else. The browser is registered for the
# larder: scheme with a desktop file whose Exec line is: larder-open %u
# LARDER_DRY_RUN=1 prints what would be tried and runs nothing.
set -eu
LC_ALL=C
export LC_ALL
set -f

[ "$#" -eq 1 ] || { echo "usage: larder-open larder://NAME" >&2; exit 64; }
id=${1#larder://}
id=${id%/}
case $id in
    ''|[!a-z]*|*[!a-z0-9-]*) echo "larder-open: not an action name" >&2; exit 64 ;;
esac

# try CMD...: run the first command whose program is installed.
try() {
    if [ -n "${LARDER_DRY_RUN:-}" ]; then
        list=
        for cand in "$@"; do list=${list:+$list || }$cand; done
        echo "would try: $list"
        exit 0
    fi
    for cand in "$@"; do
        # shellcheck disable=SC2086  # splitting is the point; globbing is off
        set -- $cand
        if command -v "$1" >/dev/null 2>&1; then exec "$@"; fi
    done
    echo "larder-open: nothing installed can do '$id'" >&2
    exit 69
}

case $id in
@@CHOICES@@
    *) echo "larder-open: unknown action '$id'" >&2; exit 64 ;;
esac
