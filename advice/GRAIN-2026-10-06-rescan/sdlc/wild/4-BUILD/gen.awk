# gen.awk -- the generator proper; run by gen.sh. Reads recipes.conf (format in
# that file), checks it, then writes every output into the directory `out`.
# Variables: out (directory), tpl (template directory), free_only (0|1).

function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function die(msg) { printf "gen.sh: %s:%d: %s\n", FILENAME, FNR, msg > "/dev/stderr"; failed = 1; exit 2 }
function fail(msg) { printf "gen.sh: %s\n", msg > "/dev/stderr"; failed = 1; exit 2 }

function esc_html(s,   i, c, r) {
    r = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "&") r = r "&amp;"
        else if (c == "<") r = r "&lt;"
        else if (c == ">") r = r "&gt;"
        else if (c == "\"") r = r "&quot;"
        else r = r c
    }
    return r
}
function esc_el(s,   i, c, r) {
    r = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\\" || c == "\"") r = r "\\"
        r = r c
    }
    return r
}

# One block of text per marker: the choices a profile shows, in file order.
# kind is html, el, or arms (arms = every choice, for larder-open).
function block(p, kind,   i, id, a, n, shown, line, text, cmds) {
    text = ""
    for (i = 1; i <= nch; i++) {
        id = cid[i]
        shown = 0
        cmds = ""
        for (a = 1; a <= nalt[id]; a++) {
            n = cneeds[id, a]
            if (kind == "arms") { cmds = cmds " '" crun[id, a] "'"; shown = 1 }
            else if (n == "-" || ((p SUBSEP n) in P)) { shown = 1; break }
        }
        if (!shown) continue
        if (kind == "html")
            line = "<li><a class=\"btn\" href=\"larder://" id "\">" esc_html(clabel[id]) "</a><span class=\"help\">" esc_html(chelp[id]) "</span></li>"
        else if (kind == "el")
            line = "(\"" id "\" \"" esc_el(clabel[id]) "\" \"" esc_el(chelp[id]) "\")"
        else
            line = id ") try" cmds " ;;"
        text = text line "\n"
    }
    return text
}

# Copy a template, replacing the marker lines.
function render(src, dest, p, kind,   line) {
    if ((getline line < src) <= 0) fail("cannot read template " src)
    do {
        if (line ~ /^[ \t]*@@CHOICES@@[ \t]*$/) printf "%s", block(p, kind) > dest
        else { sub(/@@PROFILE@@/, p, line); print line > dest }
    } while ((getline line < src) > 0)
    close(src)
    close(dest)
}

function header(file, what) {
    print "# SPDX-License-Identifier: GPL-3.0-or-later" > file
    print "# GENERATED by gen.sh from recipes.conf (" what "). Do not edit; change the recipe." > file
    close(file)
}

/^[ \t]*(#|$)/ { next }
{
    line = trim($0)
    split(line, w, /[ \t]+/)
    kw = w[1]
}

kw == "group" {
    if (w[2] !~ /^[a-z][a-z0-9-]*$/) die("bad group name")
    if (w[2] in isgrp) die("duplicate group " w[2])
    cur = w[2]; isgrp[cur] = 1; gname[++ngrp] = cur
    next
}

kw == "profile" || kw == "surface" || kw == "choice" {
    cur = ""
    nf = split(line, f, "|")
    for (i = 1; i <= nf; i++) f[i] = trim(f[i])
    split(f[1], h, /[ \t]+/)
    key = h[2]
    if (kw == "profile") {
        if (nf != 4) die("profile needs 4 fields")
        if (key !~ /^[a-z]+$/) die("bad profile name")
        if (key in isprof) die("duplicate profile " key)
        isprof[key] = 1; pname[++nprof] = key
        pgroups[key] = f[2]; psurf[key] = f[3]; pdeny[key] = f[4]
    } else if (kw == "surface") {
        if (nf != 2) die("surface needs 2 fields")
        if (key !~ /^(html|el)$/) die("surface must be html or el")
        sneeds[key] = f[2]
    } else {
        if (nf != 5) die("choice needs 5 fields")
        if (key !~ /^[a-z][a-z0-9-]*$/) die("bad choice id")
        if (f[2] == "" || f[3] == "") die("choice needs a label and help text")
        if (f[5] !~ /^[a-z0-9][a-z0-9 ._=-]*$/) die("run command has a character outside [a-z0-9 ._=-]")
        if (f[4] != "-" && f[4] !~ /^(pip:)?[a-z0-9][a-z0-9+._-]+$/) die("bad needs")
        if (key in nalt) {
            if (clabel[key] != f[2] || chelp[key] != f[3]) die("fallback for " key " must repeat the same label and help")
        } else { cid[++nch] = key; clabel[key] = f[2]; chelp[key] = f[3] }
        nalt[key]++
        cneeds[key, nalt[key]] = f[4]; crun[key, nalt[key]] = f[5]
    }
    next
}

{
    if (cur == "") die("package line outside any group: " line)
    pkg = w[1]; flag = w[2]
    if (pkg !~ /^[a-z0-9][a-z0-9+.-]+$/ && pkg !~ /^pip:[a-z0-9][a-z0-9._-]*$/) die("bad package name: " pkg)
    if (flag != "" && flag != "nff" && flag != "local") die("unknown flag: " flag)
    if (w[3] != "") die("trailing text after " pkg)
    if (pkg in flagof && flagof[pkg] != flag) die(pkg " is flagged differently in two groups")
    flagof[pkg] = flag
    allpkg[pkg] = 1
    nmem[cur]++; mem[cur, nmem[cur]] = pkg
    next
}

END {
    if (failed) exit 2
    if (nprof == 0) fail("no profile defined")
    if (nch == 0) fail("no choice defined")
    for (i = 1; i <= nch; i++)
        for (a = 1; a <= nalt[cid[i]]; a++) {
            n = cneeds[cid[i], a]
            if (n != "-" && !(n in allpkg)) fail("choice " cid[i] " needs " n ", which no group provides")
        }

    for (pi = 1; pi <= nprof; pi++) {
        p = pname[pi]
        ng = split(pgroups[p], gl, ",")
        if (pgroups[p] == "*") { ng = ngrp; for (i = 1; i <= ngrp; i++) gl[i] = gname[i] }
        for (i = 1; i <= ng; i++) {
            g = trim(gl[i])
            if (!(g in isgrp)) fail("profile " p " names unknown group " g)
            for (k = 1; k <= nmem[g]; k++) {
                m = mem[g, k]
                if (free_only == 1 && flagof[m] == "nff") continue
                P[p, m] = 1
                if (flagof[m] == "nff") nff[p] = 1
            }
        }
        if (pdeny[p] != "-") {
            nd = split(pdeny[p], dl, ",")
            for (i = 1; i <= nd; i++) {
                d = trim(dl[i])
                if (d !~ /^[a-z0-9][a-z0-9+.-]+$/) fail("profile " p ": bad deny name " d)
                if ((p SUBSEP d) in P) fail("profile " p " denies " d " but also includes it")
                deny[p, ++ndeny[p]] = d
            }
        }
        ns = split(psurf[p], sl, ",")
        for (i = 1; i <= ns; i++) {
            s = trim(sl[i])
            if (!(s in sneeds)) fail("profile " p ": no surface record for " s)
            if (!((p SUBSEP sneeds[s]) in P)) fail("profile " p ": surface " s " needs " sneeds[s] ", which the profile lacks")
            surf[p, i] = s
        }
        nsurf[p] = ns
    }

    # Everything checked; now write.
    for (pi = 1; pi <= nprof; pi++) {
        p = pname[pi]
        f1 = out "/" p ".packages"; f2 = out "/" p ".pip"; f3 = out "/" p ".areas"; f4 = out "/" p ".preferences"
        header(f1, "Debian packages for profile " p)
        header(f2, "PyPI names for profile " p " -- names only, lock and hash them before use")
        cmd1 = "LC_ALL=C sort -u >> '" f1 "'"
        cmd2 = "LC_ALL=C sort -u >> '" f2 "'"
        for (key in P) {
            split(key, kk, SUBSEP)
            if (kk[1] != p) continue
            if (kk[2] ~ /^pip:/) print substr(kk[2], 5) | cmd2
            else print kk[2] | cmd1
        }
        close(cmd1); close(cmd2)
        header(f3, "archive areas for live-build --archive-areas, profile " p)
        print (nff[p] ? "main non-free-firmware" : "main") >> f3
        close(f3)
        header(f4, "apt pins keeping denied packages out of profile " p)
        for (i = 1; i <= ndeny[p]; i++) {
            printf "\nPackage: %s\nPin: version *\nPin-Priority: -1\n", deny[p, i] >> f4
        }
        close(f4)
        for (i = 1; i <= nsurf[p]; i++)
            render(tpl "/firstrun." surf[p, i] ".in", out "/" p ".firstrun." surf[p, i], p, surf[p, i])
    }
    render(tpl "/larder-open.in", out "/larder-open", "", "arms")
    exit 0
}
