prove_red() {
    echo "lr1ck --prove-red: a green control, then each planted fault must be caught by its own check."
    echo "(shell running the checks: $RUNSH)"
    echo ""
    echo "control (the prototype as it is):"
    STEP=control
    $RUNSH "$SELF" --root "$R" --quiet > "$T/control.out" 2>&1; crc=$?
    sed 's/^/    /' "$T/control.out" | tail -3
    if [ "$crc" -eq 2 ]; then echo "PROVE-RED: NOT CHECKED (exit 2): the control itself could not run fully, so no fault can be proved"; return 2; fi
    if [ "$crc" -ne 0 ]; then echo "PROVE-RED: FAIL (exit 1): the control is not green (exit $crc)"; return 1; fi
    echo "control is green. Planting faults, one at a time, in a copy:"
    : > "$T/missed"
    echo "$FAULTS" | while IFS='|' read -r name ids desc; do
        STEP="plant $name"
        rm -rf "$T/pr"; mkdir -p "$T/pr"; cp -R "$R" "$T/pr/4-BUILD"; cp "$R"/../[1-6]-*.md "$T/pr/" 2>/dev/null
        plant "$name" "$T/pr"
        modes0=$(cd "$R" && find . -type f -perm -100 | sort); modes1=$(cd "$T/pr/4-BUILD" && find . -type f -perm -100 | sort)
        if diff -r "$R" "$T/pr/4-BUILD" >/dev/null 2>&1 && [ "$modes0" = "$modes1" ] && [ "$(cat "$R"/../[1-6]-*.md | cksum)" = "$(cat "$T"/pr/[1-6]-*.md | cksum)" ]; then echo "  NOT PLANTED  $name: the change did not apply, so this proves nothing"; echo x >> "$T/missed"; continue; fi
        if [ "$name" != tool-not-executable ] && [ "$modes0" != "$modes1" ]; then
            echo "  NOT PLANTED  $name: the planted copy lost an executable bit, so a tool would fail for the wrong reason"; echo x >> "$T/missed"; continue; fi
        out=$($RUNSH "$SELF" --root "$T/pr/4-BUILD" --only "$ids" --quiet 2>&1); rc=$?
        said=$(echo "$out" | grep "^  FAIL  $ids " | head -1 | sed 's/^  FAIL  [A-Z0-9]* *//' | cut -c1-120)
        if [ "$rc" -eq 1 ] && [ -n "$said" ]; then
            printf '  caught   %-26s by %s\n           planted: %s\n           %s said: %s\n' "$name" "$ids" "$desc" "$ids" "$said"
        else
            printf '  MISSED   %-26s expected %s, got exit %s (%s)\n' "$name" "$ids" "$rc" "$desc"; echo x >> "$T/missed"
        fi
    done
    echo ""
    echo "the exit-code paths of lr1ck itself:"
    # exit 2: take emacs, node and gpg off the path; the checks that need them must say NOT CHECKED, not pass
    mkdir -p "$T/nopath"
    for f in /usr/bin/* /bin/*; do n=${f##*/}; case $n in emacs*|node*|nodejs*|gpg*) continue ;; esac; [ -e "$T/nopath/$n" ] || ln -s "$f" "$T/nopath/$n" 2>/dev/null; done
    out=$(PATH=$T/nopath $RUNSH "$SELF" --root "$R" --only B3,B4,C9,C10,D4 2>&1); rc=$?
    if [ "$rc" -eq 2 ] && echo "$out" | grep -q 'SKIP  B4 ' && echo "$out" | grep -q 'SKIP  C10' && ! echo "$out" | grep -q '^  FAIL  '; then
        echo "  caught   a missing tool           exit 2 and SKIP ... NOT CHECKED for B3, B4, C9, C10 and D4's signed path (never a pass)"
    else echo "  MISSED   a missing tool           expected exit 2 with SKIP lines, got exit $rc"; echo x >> "$T/missed"; fi
    # exit 3: stop on purpose
    out=$($RUNSH "$SELF" --root "$R" --crash 2>&1); rc=$?
    if [ "$rc" -eq 3 ] && echo "$out" | grep -q 'Paste this line'; then
        echo "  caught   an unexpected stop       exit 3 and a line to paste into a session"
    else echo "  MISSED   an unexpected stop       expected exit 3 with a heal prompt, got exit $rc"; echo x >> "$T/missed"; fi
    nf=$(($(echo "$FAULTS" | wc -l) + 2))
    if [ -s "$T/missed" ]; then echo "PROVE-RED: FAIL (exit 1): $(wc -l < "$T/missed" | tr -d ' ') of $nf planted faults or paths were not caught"; return 1; fi
    echo "PROVE-RED: PASS (exit 0): the control was green and all $nf planted faults and exit paths were caught by the check meant to catch them"
    return 0
}

if [ "$CRASH" = 1 ]; then
    STEP=crash-on-purpose
    : "${LR1CK_THIS_IS_NEVER_SET:?stopping on purpose (--crash)}"
fi
if [ "$PROVE" = 1 ]; then
    prove_red; rc=$?; finish "$rc"
fi

[ "$QUIET" = 1 ] || { echo "lr1ck on $R"; echo "tools: sh=$(readlink -f /bin/sh 2>/dev/null | xargs basename 2>/dev/null) awk=$(awk -W version 2>&1 | head -1) emacs=$(have emacs && emacs --version | head -1 || echo none) node=$(have node && node --version || echo none) gpg=$(have gpg && echo yes || echo no)"; echo ""; }
run_checks "${ONLY:-$CHECKS}"
verdict; rc=$?
if [ "$QUIET" != 1 ] && [ -z "$ONLY" ]; then
    echo ""
    echo "Not checked by this script, by design: that anything boots; that an ISO builds; that the lists install (apt resolves"
    echo "dependencies, runs maintainer scripts); a real browser, screen or mouse, or the larder: link handler; awk other than"
    echo "the one on this machine; any Org version other than the one run; whether the Reticulum licence text still reads the"
    echo "same upstream today."
fi
finish "$rc"
