    [ -e "$f.asc" ] && bads="$bads a signature file ships with a draft;"
    [ -z "$bads" ] && ok D1 "the shipped notice is a draft, unsigned, grants nothing, and its mark says the author has not read the work" || bad D1 "$bads"
}
chk_D2() {
    out=$("$R/bin/lr1bk" "$R/author/books.org" 2>"$T/d2.err"); rc=$?
    [ "$rc" -eq 0 ] && [ -z "$out" ] && ok D2 "the shipped book list lets nothing through ($(cat "$T/d2.err" | sed 's/^lr1bk: //'))" || bad D2 "exit $rc, rows let through: '$out' $(head -1 "$T/d2.err")"
}
chk_D3() {
    h='| slug | title | right | sold by author | checked by | date | include |
|---+---+---+---+---+---+---|'
    t() { printf '%s\n%s\n' "$h" "$1" > "$T/d3.org"; "$R/bin/lr1bk" "$T/d3.org" 2>/dev/null; }
    bads=
    t '| a-1 | x | audio | unknown |  |  | yes |' >/dev/null && bads="$bads sold=unknown let through;"
    t '| a-1 | x | audio | yes | me | 2026-01-01 | yes |' >/dev/null && bads="$bads sold=yes let through;"
    t '| a-1 | x | text | no |  | 2026-01-01 | yes |' >/dev/null && bads="$bads nobody named, let through;"
    t '| a-1 | x | text | no | me | soon | yes |' >/dev/null && bads="$bads no real date, let through;"
    t '| a-1 | x | film | no | me | 2026-01-01 | yes |' >/dev/null && bads="$bads unknown right let through;"
    printf '%s\n| a-1 | x | text | no | me | 2026-01-01 | no |\n| a-1 | x | text | no | me | 2026-01-01 | no |\n' "$h" > "$T/d3.org"; "$R/bin/lr1bk" "$T/d3.org" >/dev/null 2>&1 && bads="$bads duplicate row let through;"
    got=$(t '| a-1 | x | text | no | me | 2026-01-01 | yes |'); [ "$got" = "a-1 text" ] || bads="$bads a good row was not passed (got '$got');"
    [ -z "$bads" ] && ok D3 "the gate refuses unknown, sold, unattended, undated, odd-right and duplicate rows, and passes one good row" || bad D3 "$bads"
}
chk_D4() {
    work=$T/work.txt; echo "A made-up story, for the test only." > "$work"; bads=
    out=$("$R/bin/lr1st" "$work" 2>&1); rc=$?
    { [ "$rc" -eq 1 ] && echo "$out" | grep -q 'DRAFT'; } || bads="$bads the draft notice did not stop the stamp (exit $rc);"
    if ! have gpg || ! have gpgv; then
        [ -z "$bads" ] || { bad D4 "$bads"; return; }
        skip D4 "gpg is not installed, so the signed-notice path was not run (the draft was refused, as it should)"; return
    fi
    export GNUPGHOME=$T/gh; mkdir -m700 "$GNUPGHOME"
    gpg --batch --pinentry-mode loopback --passphrase '' --quick-generate-key fixture-author@example.invalid ed25519 sign never >/dev/null 2>&1
    sed -e 's/^STATUS: DRAFT/STATUS: IN FORCE/' -e 's/^SIGNED: no/SIGNED: yes (fixture)/' -e 's/^AUTHOR: .*/AUTHOR: Fixture Author/' "$R/author/PERMISSION-NOTICE.md" > "$T/notice.md"
    gpg --batch --pinentry-mode loopback --passphrase '' --detach-sign --output "$T/notice.md.asc" "$T/notice.md" >/dev/null 2>&1
    gpg --export > "$T/author.gpg" 2>/dev/null
    out=$(LARDER_AUTHOR_KEYRING=$T/author.gpg "$R/bin/lr1st" --notice "$T/notice.md" "$work" 2>&1); rc=$?
    { [ "$rc" -eq 0 ] && echo "$out" | grep -q 'Published by permission of Fixture Author' && echo "$out" | grep -q 'has not read, reviewed or endorsed' && echo "$out" | grep -q 'A made-up story'; } || bads="$bads a properly signed notice did not stamp (exit $rc);"
    echo "an edit after signing" >> "$T/notice.md"
    LARDER_AUTHOR_KEYRING=$T/author.gpg "$R/bin/lr1st" --notice "$T/notice.md" "$work" >/dev/null 2>&1 && bads="$bads a notice edited after signing still stamped;"
    rm -f "$T/notice.md.asc"
    LARDER_AUTHOR_KEYRING=$T/author.gpg "$R/bin/lr1st" --notice "$T/notice.md" "$work" >/dev/null 2>&1 && bads="$bads 'IN FORCE' text with no signature still stamped;"
    : > "$T/empty.gpg"; sed -e 's/^STATUS: DRAFT/STATUS: IN FORCE/' "$R/author/PERMISSION-NOTICE.md" > "$T/n2.md"; gpg --batch --pinentry-mode loopback --passphrase '' --detach-sign --output "$T/n2.md.asc" "$T/n2.md" >/dev/null 2>&1
    LARDER_AUTHOR_KEYRING=$T/empty.gpg "$R/bin/lr1st" --notice "$T/n2.md" "$work" >/dev/null 2>&1 && bads="$bads a signature by a key the author does not hold still stamped;"
    unset GNUPGHOME
    [ -z "$bads" ] && ok D4 "no stamp for a draft; a stamp only when 'IN FORCE' AND the author's signature verifies; edited-after-signing, unsigned and wrong-key all refused" || bad D4 "$bads"
}
chk_D5() {
    bads=
    find "$R" -type f \( -iname '*.epub' -o -iname '*.mobi' -o -iname '*.azw*' -o -iname '*.pdf' -o -iname '*.mp3' -o -iname '*.m4a' -o -iname '*.m4b' -o -iname '*.ogg' -o -iname '*.flac' -o -iname '*.wav' -o -iname '*.docx' -o -iname '*.odt' -o -iname '*.djvu' \) > "$T/d5.out"
    [ -s "$T/d5.out" ] && bads="$bads book-like files: $(head -2 "$T/d5.out" | tr '\n' ' ');"
    have=$(ls "$R/author" | tr '\n' ' ')
    [ "$have" = "PERMISSION-NOTICE.md books.org " ] || bads="$bads author/ holds [$have];"
    size=$(cat "$R"/author/* | wc -c | tr -d ' ')
    [ "$size" -le 17408 ] || bads="$bads author/ is $size bytes, too big to be only a notice and a list;"
    [ -z "$bads" ] && ok D5 "author/ holds only the notice and the book list ($size bytes); no e-book, audio or document file anywhere in 4-BUILD" || bad D5 "$bads"
}

# ================================================================ E: honest status
chk_E1() {
    f=$R/README.md; bads=
    [ -r "$f" ] || { bad E1 "README.md is missing"; return; }
    grep -q '^## What was not checked' "$f" || bads="$bads no 'What was not checked' section;"
    for w in 'booted' 'ISO' 'browser' 'apt' 'gawk'; do
        awk '/^## What was not checked/ { s = 1; next } /^## / { s = 0 } s' "$f" | grep -q "$w" || bads="$bads the section does not mention $w;"
    done
    [ -z "$bads" ] && ok E1 "README names what was not checked: boot, ISO build, a real browser, an apt install, other awks" || bad E1 "$bads"
}

chk_E2() {
    prep_awk; d=$R/../3-DESIGN.md
    [ -r "$d" ] || { skip E2 "3-DESIGN.md is not there to compare"; return; }
    awk -F'|' '/^\| *(minimal|desktop|homelab|hardened|fullsink) *\|/ { for (i = 2; i <= 7; i++) gsub(/^ +| +$/, "", $i); print $2 "|" $4 "|" $3 "|" $5 "|" $6 "|" $7 }' "$d" > "$T/e2.doc"
    awk -F'|' '/^\| *(minimal|desktop|homelab|hardened|fullsink) *\|/ { for (i = 2; i <= 4; i++) gsub(/^ +| +$/, "", $i); print $2 "|" $4 }' "$RECIPES" > "$T/e2.groups"
    : > "$T/e2.want"
    for p in $PROFILES; do
        n=$(grep -v -e '^#' -e '^$' "$(pkfile $p)" | wc -l | tr -d ' ')
        fw=off; grep -qx -e '--archive-areas main non-free-firmware' "$T/awk/out/$p.lbflags" && fw=on
        line=$(grep "^$p|" "$T/awk/out/profiles.txt" | grep -v '^#'); shell=$(echo "$line" | cut -d'|' -f2); whom=$(echo "$line" | cut -d'|' -f3)
        g=$(grep "^$p|" "$T/e2.groups" | cut -d'|' -f2)
        echo "$p|$shell|$whom|$g|$n|$fw" >> "$T/e2.want"
    done
    if cmp -s "$T/e2.doc" "$T/e2.want" && [ "$(wc -l < "$T/e2.doc" | tr -d ' ')" = 5 ]; then
        ok E2 "the profile table in 3-DESIGN (for whom, shell, groups, package count, firmware) equals profiles.txt, the recipe table and the line counts of out/"
    else bad E2 "3-DESIGN's table differs from the generated files: $(diff "$T/e2.doc" "$T/e2.want" | grep '^[<>]' | head -2 | cut -c1-120 | tr '\n' ' ')"; fi
}
chk_E3() {
    D=$R/..; bads=
    for f in 1-IDEATION 2-ANALYSIS 3-DESIGN 6-REVIEW; do [ -r "$D/$f.md" ] || bads="$bads $f.md is missing;"; done
    [ -d "$R" ] && [ -d "$HERE" ] || bads="$bads 4-BUILD or 5-TEST is missing;"
    if [ -r "$D/1-IDEATION.md" ]; then
        n=$(grep -c '^### A[0-9][0-9]*\. ' "$D/1-IDEATION.md"); [ "$n" -ge 5 ] || bads="$bads 1-IDEATION has $n approaches, wanted five or more;"
        grep -q '^## The pick' "$D/1-IDEATION.md" || bads="$bads 1-IDEATION has no pick;"
        grep -q '^<!-- produced-by: lens · subject: ' "$D/1-IDEATION.md" || bads="$bads 1-IDEATION has no LENS head line;"
        grep -q 'persona' "$D/1-IDEATION.md" && grep -q 'inverse' "$D/1-IDEATION.md" || bads="$bads 1-IDEATION has no persona and inverse;"
        sub=$(sed -n 's/^<!-- produced-by: lens · subject: \([^ ]*\) · sha256: \([0-9a-f]*\) .*/\1 \2/p' "$D/1-IDEATION.md" | head -1)
        subj=${sub%% *}; pin=${sub##* }
        if [ -n "$subj" ] && [ -r "$D/../$subj" ]; then
            [ "$(sha256sum "$D/../$subj" | cut -d' ' -f1)" = "$pin" ] || bads="$bads the LENS head line pins a different $subj than the one on disk;"
        else note "(the LENS subject file was not found beside the stage files, so its hash was not compared)"; fi
    fi
    if [ -r "$D/2-ANALYSIS.md" ]; then
        awk '/^### R[0-9]+\. / { if (id != "") chk(); id = $2; w = f = o = 0; n++; next } /^## / { if (id != "") chk(); id = "" } id != "" && /^- Whose concern:/ { w = 1 } id != "" && /^- Falsifier:/ { f = 1 } id != "" && /^- OBSERVED:/ { o = 1 }
             function chk() { if (!w) { printf "%s has no whose-concern; ", id; e++ } if (!f) { printf "%s has no falsifier; ", id; e++ } if (!o) { printf "%s has nothing observed; ", id; e++ } }
             END { if (id != "") chk(); if (n < 5) { printf "only %d risks; ", n; e++ } exit e ? 1 : 0 }' "$D/2-ANALYSIS.md" > "$T/e3.out" || bads="$bads 2-ANALYSIS: $(cat "$T/e3.out");"
        for h in '## Constraints' '## Risks' '## Unknowns' '## What would prove the pick wrong'; do grep -q "^$h" "$D/2-ANALYSIS.md" || bads="$bads 2-ANALYSIS lacks '$h';"; done
    fi
    if [ -r "$D/3-DESIGN.md" ]; then for h in '## Architecture' '## The five profiles' '## The first-run flow'; do grep -q "^$h" "$D/3-DESIGN.md" || bads="$bads 3-DESIGN lacks '$h';"; done; fi
    if [ -r "$D/6-REVIEW.md" ]; then for h in '## What is good' '## What is weak' '## What I did not check' '## What I would do next' '## Facts that came from the web'; do grep -q "^$h" "$D/6-REVIEW.md" || bads="$bads 6-REVIEW lacks '$h';"; done; fi
    [ -z "$bads" ] && ok E3 "the stage documents have what the brief asks: five or more approaches and a pick, the LENS head line pinned to its subject, every risk with an owner, what was observed and a falsifier, the architecture and profile and flow sections, and the four review parts" || bad E3 "$bads"
}
chk_E4() {
    D=$R/..; r=$D/6-REVIEW.md
    [ -r "$r" ] || { skip E4 "6-REVIEW.md is not there"; return; }
    mark=$(printf '\342\200\240'); bads=; line=$(grep '^daggers: ' "$r" | head -1)
    [ -n "$line" ] || { bad E4 "6-REVIEW.md has no 'daggers:' line stating the counts"; return; }
    for f in 1-IDEATION 2-ANALYSIS 3-DESIGN 6-REVIEW; do
        have=$(grep -o "$mark" "$D/$f.md" 2>/dev/null | wc -l | tr -d ' ')
        said=$(echo "$line" | sed -n "s/.*$f=\([0-9]*\).*/\1/p")
        [ "$said" = "$have" ] || bads="$bads $f says '${said:-nothing}' but has $have;"
    done
    [ -z "$bads" ] && ok E4 "the dagger counts stated in 6-REVIEW ($line) are what grep counts in each document" || bad E4 "stale counts:$bads"
}

# ================================================================ run
run_checks() {
    for id in $1; do
        STEP=$id
        if ! command -v "chk_$id" >/dev/null 2>&1; then echo "lr1ck: no such check '$id' (see --list)" >&2; finish 1; fi
        "chk_$id"
    done
}

verdict() {
    echo ""
    printf '%d passed, %d FAILED, %d not checked\n' "$PASSES" "$FAILS" "$SKIPS"
    if [ "$FAILS" -gt 0 ]; then echo "RESULT: FAIL (exit 1)"; return 1; fi
    if [ "$SKIPS" -gt 0 ]; then echo "RESULT: NOT CHECKED (exit 2): a tool or file a check needs is missing; this is not a pass"; return 2; fi
    echo "RESULT: PASS (exit 0)"; return 0
}

# -------------------------------------------------------------- prove-red: each planted fault must be caught by its own check
# a planted change must keep the file's mode (a lost executable bit makes a tool fail for the wrong reason)
mut() { f=$1; shift; sed "$@" "$f" > "$f.mut" && cat "$f.mut" > "$f" && rm -f "$f.mut"; }
swap() { cat "$1.new" > "$1" && rm -f "$1.new"; }
# plant NAME DIR: change one thing in the copy under DIR/4-BUILD
plant() {
    b=$2/4-BUILD
    case $1 in
      typo-package)        mut "$b/recipes.org" -e 's/^rsync$/rsyncc/' ;;
      nonfree-in-desktop)  mut "$b/recipes.org" -e 's/^evince$/firmware-iwlwifi/' ;;
      package-in-two-groups) awk '{ print } /^nmap$/ { print "git" }' "$b/recipes.org" > "$b/recipes.org.new" && swap "$b/recipes.org" ;;
      live-build-command-line) awk '{ print } /^#\+name: g-core$/ { getline; print; print "!echo planted" }' "$b/recipes.org" > "$b/recipes.org.new" && swap "$b/recipes.org" ;;
      reader-drops-newline) mut "$b/bin/lr1tg.awk" -e 's/^\( *\)ln = body\[t\]$/\1ln = body[t] "\\n"/' ;;
      silent-bad-ref)      awk '!d && /^<<g-boot>>$/ { print "<<g-bot>>"; d = 1; next } { print }' "$b/recipes.org" > "$b/recipes.org.new" && swap "$b/recipes.org" ;;
      stale-out)           printf 'zz-stale\n' >> "$b/out/desktop.packages" ;;
      flag-typo)           mut "$b/recipes.org" -e 's/--uefi-secure-boot enable/--uefi-secureboot enable/' ;;
      table-drifts-from-blocks) mut "$b/recipes.org" -e 's/^| hardened | the desktop with fewer parts and more guards          | boot core token console xfce access apps hardening onion/| hardened | the desktop with fewer parts and more guards          | boot core token console xfce access apps hardening/' ;;
      description-drift)   mut "$b/recipes.org" -e 's/^homelab|emacs|a headless chapter server/homelab|emacs|a headless server/' ;;
      mesh-standing-unlabelled) awk '!d && /^rns\|/ { sub(/\|restricted\|/, "|probably-fine|"); d = 1 } { print }' "$b/recipes.org" > "$b/recipes.org.new" && swap "$b/recipes.org" ;;
      no-browser)          mut "$b/recipes.org" -e '/^firefox-esr$/d' ;;
      command-in-wrong-package) mut "$b/recipes.org" -e 's/|Open a word processor\.|lowriter$/|Open a word processor.|libreoffice --writer/' ;;
      i386-flag)           mut "$b/recipes.org" -e 's/^--architecture amd64$/--architecture i386/' ;;
      design-count-drift)  mut "$2/3-DESIGN.md" -e 's/| boot core token console vtmouse | 34 |/| boot core token console vtmouse | 35 |/' ;;
      risk-without-falsifier) awk '!d && /^- Falsifier:/ { sub(/Falsifier:/, "Test:"); d = 1 } { print }' "$2/2-ANALYSIS.md" > "$2/2-ANALYSIS.md.new" && swap "$2/2-ANALYSIS.md" ;;
      dagger-count-stale)  printf '\342\200\240\n' >> "$2/2-ANALYSIS.md" ;;
      ui-promise-broken)   mut "$b/recipes.org" -e 's/^library|base|desktop hardened fullsink|kiwix|/library|base|desktop hardened fullsink|kiwix-tools|/' ;;
      phone-home)          awk '/^<\/head>/ { print "<script src=\"https://cdn.example.invalid/x.js\"></script>" } { print }' "$b/shell/first-run.html" > "$b/shell/first-run.html.new" && swap "$b/shell/first-run.html" ;;
      html-says-other-words) mut "$b/shell/first-run.html" -e 's/Join my group/Join my chapter/' ;;
      small-target)        mut "$b/shell/first-run.html" -e 's/^\.choice{display:block;min-height:4.5rem/.choice{display:block;min-height:1.5rem/' ;;
      no-color-scheme)     mut "$b/shell/first-run.html" -e '/^html{color-scheme:light dark}$/d' ;;
      dark-palettes-split) mut "$b/shell/first-run.html" -e '/^:root\[data-theme="dark"\]{/,/^}/ s/--fg:#ffffff/--fg:#fefefe/' ;;
      low-contrast)        mut "$b/shell/first-run.html" -e 's/--muted:#505050;/--muted:#b0b0b0;/' ;;
      colour-not-modus)    mut "$b/shell/first-run.html" -e 's/--accent:#0031a9; \/\* modus:blue/--accent:#0030a9; \/* modus:blue/' ;;
      system-click-sets-light) mut "$b/shell/first-run.html" -e 's/r.removeAttribute("data-theme");/r.setAttribute("data-theme", "light");/' ;;
      tag-left-open)       mut "$b/shell/first-run.html" -e 's/^<\/main>$//' ;;
      page-script-no-filter) mut "$b/shell/first-run.html" -e 's/if (d !== "\*" \&\& d.split(" ").indexOf(p) < 0) { li.hidden = true; }//' ;;
      dead-button)         mut "$b/shell/larder-first-run.el" -e 's/(lambda () (larder-first-run--act id))/(lambda () nil)/' ;;
      tool-not-executable) chmod -x "$b/bin/lr1bk" ;;
      silent-flag)         mut "$b/bin/lr1op" -e 's/^        -\*) echo "lr1op: unknown option.*$/        -*) ;;/' ;;
      missing-spdx)        mut "$b/bin/lr1op" -e '/^# SPDX-License-/d' ;;
      notice-flipped-to-in-force) mut "$b/author/PERMISSION-NOTICE.md" -e 's/^STATUS: DRAFT/STATUS: IN FORCE/' ;;
      book-gate-hole)      printf '| example-9 | (x) | audio | unknown |  |  | yes |\n' >> "$b/author/books.org" ;;
      gate-ignores-sold)   mut "$b/bin/lr1bk" -e '/include=yes but sold-by-author is/d' ;;
      stamp-skips-signature) mut "$b/bin/lr1st" -e 's/^gpgv --keyring .*$/true ||/' ;;
      book-file-smuggled)  printf 'x' > "$b/author/story.epub" ;;
      readme-silent-on-limits) awk '/^## What was not checked/ { next } { print }' "$b/README.md" > "$b/README.md.new" && swap "$b/README.md" ;;
    esac
}
