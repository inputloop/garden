#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# lr1ck -- LaRder 1 ChecK: checks the garden prototype in ../4-BUILD, and can show itself failing.
#
#   lr1ck [--root DIR] [--only A1,B4,...] [--quiet]     run the checks (default: all)
#   lr1ck [--root DIR] --prove-red                      a green control, then planted faults; each must be caught
#   lr1ck --list                                        the checks and what they are
#   lr1ck --crash                                       stop on purpose, to show the exit-3 path
#
# Exit:  0 every check passed         1 a check failed (or a planted fault was NOT caught)
#        2 NOT CHECKED: a tool or file a check needs is missing; said loudly, never silently green
#        3 stopped unexpectedly: prints a line to paste into a session to find the cause
#
# What counts as evidence here (the seams doctrine): one reader of a fact is data; two independent
# readers that agree are evidence.  The facts and their readers:
#   what recipes.org says       reader 1: bin/lr1tg (awk)       reader 2: org-babel-tangle in Emacs
#   which choices an edition    lr1op (sh) | an awk rule | the Emacs shell | the page's own script (stub DOM)
#   offers
#   the colours                 the page's CSS               | Emacs' own Modus themes
#   Debian package names        the lists                    | the signed Debian index (evidence/)
# Tiebreakers: Org's own behaviour for tangling; Debian's index for names; the recipes for the choices.
# Not checked by this script, by design: that anything boots, that an ISO builds, that the lists install,
# a real browser, a real screen and mouse, awk other than the one on this machine.

set -u
LC_ALL=C; export LC_ALL
HERE=$(cd "$(dirname "$0")" && pwd)
SELF=$HERE/$(basename "$0")
if [ -n "${BASH_VERSION:-}" ]; then RUNSH="$BASH --posix"; else RUNSH=$(command -v sh); fi
ROOT=$HERE/../4-BUILD
EVID=$HERE/evidence
QUIET=0 PROVE=0 CRASH=0 ONLY= STEP=start DONE=0 PASSES=0 FAILS=0 SKIPS=0
T=$(mktemp -d)

CHECKS="A1 A2 A3 B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 B12 B13 B14 B15 B16 B17 C1 C2 C3 C4 C5 C6 C7 C8 C9 C10 C11 C12 C13 D1 D2 D3 D4 D5 E1 E2 E3 E4"

finish() { DONE=1; exit "$1"; }
on_exit() {
    rc=$?
    rm -rf "$T"
    if [ "$DONE" -ne 1 ]; then
        echo "" >&2
        echo "lr1ck: STOPPED UNEXPECTEDLY (shell status $rc) while at step '$STEP'." >&2
        echo "Paste this line and the command you ran into a session and ask it to find the cause, prove it red, then fix it:" >&2
        echo "  lr1ck stopped unexpectedly at step $STEP (shell status $rc)" >&2
        exit 3
    fi
}
trap on_exit EXIT

ok()   { PASSES=$((PASSES + 1)); [ "$QUIET" = 1 ] || printf '  ok    %-4s %s\n' "$1" "$2"; }
bad()  { FAILS=$((FAILS + 1)); printf '  FAIL  %-4s %s\n' "$1" "$2"; }
skip() { SKIPS=$((SKIPS + 1)); printf '  SKIP  %-4s %s -- NOT CHECKED\n' "$1" "$2"; }
note() { [ "$QUIET" = 1 ] || printf '          %s\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() { sed -n '4,15p' "$SELF"; }
list_checks() {
cat <<'EOF'
A1 every file has one SPDX line, and the right one       A2 tools refuse unknown options
A3 every tool in bin/ is executable and starts with #!    
B1 reader one (awk) tangles recipes.org                  B2 every <<ref>> has exactly one name (Org would stay silent)
B3 reader two (Emacs) tangles recipes.org                B4 the two readers agree, byte for byte
B5 change the recipe: both readers move together         B6 committed out/ is not stale
B7 lists are data only (no ! lines), names well formed   B8 no package in two groups
B9 every name exists in Debian 13.7 (right component)    B10 the four free profiles hold no non-free firmware
B11 build flags exist in live-build                      B12 five profiles, nested sensibly
B13 the profile table in the prose matches the blocks    B14 mesh add-on rows are complete and labelled
B15 profile descriptions agree in two places             B16 each profile has what its first-run shell needs
B17 each program a choice starts ships in the package it needs
C1 choices file is well formed                           C2 every choice's package is in each profile offering it
C3 the HTML page says what choices.txt says              C4 the page contacts nothing and is small
C5 mouse alone: targets, links, no key-only handlers     C6 the light/dark pattern is complete
C7 the two dark palettes are identical                   C8 contrast, measured, both themes
C9 the colours equal Emacs' own Modus values             C10 the page script runs (stub DOM) and both theme overrides work
C11 page tags balance                                    C12 Emacs shell compiles clean and its ERT tests pass
C13 four readers agree on what each edition offers       D1 the notice is a draft and says so
D2 the shipped book list lets nothing through            D3 the book gate refuses bad rows and passes a good one
D4 the stamp refuses without a real signature            D5 no book content, and nothing else, in the author folder
E1 the README says what was not checked                  E2 the design table equals out/ and the recipes
E3 the stage documents have the parts the brief asks for E4 the dagger counts stated in 6-REVIEW are the real counts
EOF
}

while [ $# -gt 0 ]; do
    case $1 in
        --root)  [ $# -ge 2 ] || { echo "lr1ck: --root needs a folder" >&2; finish 1; }; ROOT=$2; shift ;;
        --only)  [ $# -ge 2 ] || { echo "lr1ck: --only needs a list" >&2; finish 1; }; ONLY=$(echo "$2" | tr ',' ' '); shift ;;
        --quiet) QUIET=1 ;;
        --prove-red) PROVE=1 ;;
        --crash) CRASH=1 ;;
        --list)  list_checks; finish 0 ;;
        -h|--help) usage; finish 0 ;;
        *) echo "lr1ck: unknown option $1 (see -h)" >&2; finish 1 ;;
    esac
    shift
done
[ -d "$ROOT" ] || { echo "lr1ck: no such folder $ROOT" >&2; finish 1; }
R=$(cd "$ROOT" && pwd)
RECIPES=$R/recipes.org
HTML=$R/shell/first-run.html
PROFILES="minimal desktop homelab hardened fullsink"
FREE="minimal desktop homelab hardened"

# ---------------------------------------------------------------- shared awk programs
AWK_COLOR='
function hx(c,   a, b) { a = index("0123456789abcdef", substr(c,1,1)) - 1; b = index("0123456789abcdef", substr(c,2,1)) - 1; return a * 16 + b }
function lin(v) { v = v / 255; return (v <= 0.03928) ? v / 12.92 : exp(2.4 * log((v + 0.055) / 1.055)) }
function lum(h) { h = tolower(h); return 0.2126 * lin(hx(substr(h,2,2))) + 0.7152 * lin(hx(substr(h,4,2))) + 0.0722 * lin(hx(substr(h,6,2))) }
function ratio(a, b,   la, lb, t) { la = lum(a); lb = lum(b); if (la < lb) { t = la; la = lb; lb = t } return (la + 0.05) / (lb + 0.05) }'
# tokens: prints "set name #hex modus-key" for the three palettes in the page
AWK_TOKENS='
/^:root\{/ { set = "light"; next }
/^[ ]*:root:not\(\[data-theme="light"\]\)\{/ { set = "darkmedia"; next }
/^:root\[data-theme="dark"\]\{/ { set = "darkattr"; next }
/^[ ]*\}/ { set = ""; next }
set != "" && /^[ ]*--[a-z]+:#[0-9a-fA-F]+;/ {
    line = $0; sub(/^[ ]*--/, "", line); name = line; sub(/:.*/, "", name)
    hex = line; sub(/^[a-z]+:/, "", hex); sub(/;.*/, "", hex)
    key = "-"; if (match(line, /modus:[a-z-]+/)) key = substr(line, RSTART + 6, RLENGTH - 6)
    print set, name, tolower(hex), key
}'
# html choices: prints id|edition|profiles|label|plain for each <li> of the page
AWK_HTML_CHOICES='
/^<li data-edition-only=/ {
    n = split($0, f, "\"")
    label = f[13]; sub(/^>/, "", label); sub(/<\/span><span class=$/, "", label)
    plain = f[15]; sub(/^>/, "", plain); sub(/<\/span><\/a><\/li>$/, "", plain)
    href = f[8]; sub(/^larder:/, "", href)
    printf "%s|%s|%s|%s|%s\n", f[10], f[2], f[4], label, plain
    if (href != f[10]) print "HREF-MISMATCH|" f[10] "|" f[8]
}'
# choices.txt: prints id|edition|profiles|label|plain
AWK_CHOICES='-F|' ; AWK_CHOICES_PROG='/^#/ || NF == 0 { next } { printf "%s|%s|%s|%s|%s\n", $1, $2, $3, $5, $6 }'
# which ids does an edition offer? (independent statement of the rule)  usage: -v P=profile -v E=edition
AWK_OFFER='/^#/ || NF == 0 { next } ($2 == "base" || $2 == E) && ($3 == "*" || index(" " $3 " ", " " P " ") > 0) { printf "%s ", $1 } END { printf "\n" }'

# ---------------------------------------------------------------- lazily built shared state
TANGLED_AWK=0 TANGLED_ORG=0 AWKRC=99 ORGRC=99
prep_awk() {
    [ "$TANGLED_AWK" = 1 ] && return
    TANGLED_AWK=1
    mkdir -p "$T/awk" && cp "$RECIPES" "$T/awk/recipes.org"
    "$R/bin/lr1tg" "$T/awk/recipes.org" >"$T/awk.out" 2>"$T/awk.err"; AWKRC=$?
}
prep_org() {
    [ "$TANGLED_ORG" = 1 ] && return
    TANGLED_ORG=1
    have emacs || { ORGRC=127; return; }
    mkdir -p "$T/org" && cp "$RECIPES" "$T/org/recipes.org"
    ( cd "$T/org" && emacs --batch -Q --eval '(require (quote org))' --eval '(require (quote ob-tangle))' \
        --eval '(org-babel-tangle-file "recipes.org")' ) >"$T/org.out" 2>&1; ORGRC=$?
}
names_ready=0
prep_names() {
    [ "$names_ready" = 1 ] && return
    names_ready=1
    if have zcat && [ -r "$EVID/trixie-13.7-main.names.gz" ] && [ -r "$EVID/trixie-13.7-nff.names" ]; then
        zcat "$EVID/trixie-13.7-main.names.gz" | grep -v '^#' | sort -u > "$T/main.names"
        grep -v '^#' "$EVID/trixie-13.7-nff.names" | sort -u > "$T/nff.names"
    else
        names_ready=2
    fi
}
pk() { grep -v -e '^#' -e '^$' "$1" | sort -u; }          # the names in one list
pkfile() { echo "$T/awk/out/$1.packages"; }

# ================================================================ A: hygiene
chk_A1() {
    pat='SPDX-License-'"Identifier: "
    { find "$R" "$HERE" -type f ! -name '*.gz' ! -name '*.elc'; ls "$HERE"/../[1-6]-*.md 2>/dev/null; } > "$T/files"
    n=0; bads=
    while IFS= read -r f; do
        case $f in */bin/*|*/shell/*|*.el|*.awk|*.js|*/lr1ck) exp=GPL-3.0-or-later ;; *) exp=CC-BY-SA-4.0 ;; esac
        got=$(grep "^[^A-Za-z0-9]*$pat" "$f" | sed -e "s/.*$pat//" -e 's/[ ]*-->.*//' -e 's/[ ]*\*\/.*//' -e 's/[ ]*$//' | sort -u)
        cnt=$(grep -c "^[^A-Za-z0-9]*$pat" "$f")
        n=$((n + 1))
        if [ "$got" != "$exp" ]; then bads="$bads ${f#"$R"/}(has '$got', wants $exp)"
        elif [ "$cnt" -ne 1 ] && [ "$(basename "$f")" != recipes.org ]; then bads="$bads ${f#"$R"/}($cnt lines)"; fi
    done < "$T/files"
    for g in "$EVID"/*.gz; do [ -e "$g" ] || continue; zcat "$g" | head -3 | grep -q "$pat""CC-BY-SA-4.0" || bads="$bads $(basename "$g")"; done
    [ -z "$bads" ] && ok A1 "$n files, each with one SPDX line of the right kind" || bad A1 "SPDX line wrong in:$bads"
}
chk_A2() {
    bads=
    for t in lr1tg lr1op lr1st lr1bk; do
        out=$("$R/bin/$t" --no-such-option 2>&1); rc=$?
        [ "$rc" -eq 1 ] || bads="$bads $t(exit $rc, wanted 1)"
        case $out in *nknown*|*sage*) : ;; *) bads="$bads $t(no explanation printed)" ;; esac
    done
    [ -z "$bads" ] && ok A2 "all four tools refuse an unknown option loudly" || bad A2 "an option was swallowed:$bads"
}

chk_A3() {
    bads=; n=0
    for f in "$R"/bin/*; do
        n=$((n + 1))
        case $f in *.awk) continue ;; esac
        [ -x "$f" ] || bads="$bads ${f#"$R"/}(not executable)"
        head -1 "$f" | grep -q '^#!' || bads="$bads ${f#"$R"/}(no #! line)"
    done
    [ -z "$bads" ] && ok A3 "every tool in bin/ is executable and says how to run it ($n files; the .awk program is read by its wrapper)" || bad A3 "$bads"
}

# ================================================================ B: the recipes and their two readers
chk_B1() {
    prep_awk
    if [ "$AWKRC" -eq 0 ] && [ -s "$T/awk.out" ]; then ok B1 "reader one tangled $(wc -l < "$T/awk.out" | tr -d ' ') files"
    else bad B1 "reader one (lr1tg) refused recipes.org: $(head -1 "$T/awk.err")"; fi
}
chk_B2() {
    awk '
    tolower($0) ~ /^#\+name:/ { n = $0; sub(/^#\+[Nn][Aa][Mm][Ee]:[ \t]*/, "", n); names[n]++; next }
    tolower($0) ~ /^#\+begin_src/ { inb = 1; next }
    tolower($0) ~ /^#\+end_src/ { inb = 0; next }
    inb && /^<<[A-Za-z0-9_.-]+>>$/ { r = substr($0, 3, length($0) - 4); refs[r] = refs[r] " " FNR; nref++ }
    END { for (r in refs) if (!(r in names)) { printf "no block is named %s (lines%s)\n", r, refs[r]; e++ }
          for (n in names) if (names[n] > 1) { printf "name %s used %d times\n", n, names[n]; e++ }
          printf "%d references, %d names\n", nref, length(names) > "/dev/stderr"; exit e ? 1 : 0 }' "$RECIPES" > "$T/b2.out" 2> "$T/b2.sum"
    rc=$?
    [ "$rc" -eq 0 ] && ok B2 "every reference has exactly one name ($(cat "$T/b2.sum"))" || bad B2 "$(head -2 "$T/b2.out" | tr '\n' ';')"
}
chk_B3() {
    prep_org
    if [ "$ORGRC" -eq 127 ]; then skip B3 "Emacs is not installed, so reader two cannot run"
    elif [ "$ORGRC" -eq 0 ] && [ -d "$T/org/out" ]; then ok B3 "reader two (Emacs $(emacs --version | head -1 | sed 's/GNU Emacs //'), Org $(emacs --batch -Q --eval '(progn (require (quote org)) (princ (org-version)))' 2>/dev/null | tail -1)) tangled $(find "$T/org/out" -type f | wc -l | tr -d ' ') files"
    else bad B3 "org-babel-tangle failed: $(tail -2 "$T/org.out" | tr '\n' ' ')"; fi
}
chk_B4() {
    prep_awk; prep_org
    if [ "$ORGRC" -eq 127 ]; then skip B4 "reader two is missing, so there is no second reader to agree with"; return; fi
    if [ "$AWKRC" -ne 0 ] || [ "$ORGRC" -ne 0 ]; then bad B4 "a reader failed (awk $AWKRC, org $ORGRC)"; return; fi
    if diff -r "$T/awk/out" "$T/org/out" >"$T/b4.diff" 2>&1; then
        ok B4 "the two readers agree on every byte of $(find "$T/awk/out" -type f | wc -l | tr -d ' ') files (sha256 of all: $(find "$T/awk/out" -type f | sort | xargs cat | sha256sum | cut -c1-12))"
    else bad B4 "the readers disagree: $(head -3 "$T/b4.diff" | tr '\n' ' ')"; fi
}
chk_B5() {
    have emacs || { skip B5 "Emacs is not installed"; return; }
    for r in a o; do mkdir -p "$T/pert$r"; done
    awk '{ print } /^#\+name: g-core$/ { getline; print; print "zz-perturbation" }' "$RECIPES" > "$T/perta/recipes.org"
    cp "$T/perta/recipes.org" "$T/perto/recipes.org"
    "$R/bin/lr1tg" "$T/perta/recipes.org" >/dev/null 2>&1
    ( cd "$T/perto" && emacs --batch -Q --eval '(require (quote org))' --eval '(require (quote ob-tangle))' --eval '(org-babel-tangle-file "recipes.org")' ) >/dev/null 2>&1
    a=$(grep -l '^zz-perturbation$' "$T"/perta/out/*.packages 2>/dev/null | wc -l | tr -d ' ')
    o=$(grep -l '^zz-perturbation$' "$T"/perto/out/*.packages 2>/dev/null | wc -l | tr -d ' ')
    if [ "$a" -ge 5 ] && [ "$o" -eq "$a" ] && diff -r "$T/perta/out" "$T/perto/out" >/dev/null 2>&1; then
        ok B5 "a new line in g-core appeared in $a lists from both readers, which still agree (they read the file, not a cache)"
    else bad B5 "perturbation: awk moved $a lists, Emacs moved $o, or they now differ"; fi
}
chk_B6() {
    prep_awk
    if [ "$AWKRC" -ne 0 ]; then bad B6 "cannot compare: reader one failed"; return; fi
    if diff -r "$R/out" "$T/awk/out" >"$T/b6.diff" 2>&1; then ok B6 "committed out/ equals a fresh tangle"
    else bad B6 "out/ is stale or has stray files: $(head -2 "$T/b6.diff" | tr '\n' ' ')"; fi
}
chk_B7() {
    prep_awk; bads=
    for f in "$T"/awk/out/*.packages; do
        grep -n '^!' "$f" >/dev/null && bads="$bads $(basename "$f")(a '!' line would be RUN by live-build)"
        grep -v -e '^#' -e '^$' "$f" | grep -v -e '^[a-z0-9][a-z0-9+.-]*$' >/dev/null && bads="$bads $(basename "$f")(odd name)"
        d=$(grep -v -e '^#' -e '^$' "$f" | sort | uniq -d | tr '\n' ' '); [ -z "$d" ] || bads="$bads $(basename "$f")(listed twice: $d)"
    done
    [ -z "$bads" ] && ok B7 "lists hold only plain names, once each, nothing live-build would run" || bad B7 "$bads"
}
chk_B8() {
    awk '/^#\+name: g-/ { g = $2; next } /^#\+begin_src/ { if (g != "") inb = 1; next } /^#\+end_src/ { inb = 0; g = ""; next }
         inb { if ($0 in w) { printf "%s is in %s and %s\n", $0, w[$0], g; e++ } else w[$0] = g }
         END { exit e ? 1 : 0 }' "$RECIPES" > "$T/b8.out"
    [ $? -eq 0 ] && ok B8 "no package is in two groups" || bad B8 "$(head -3 "$T/b8.out" | tr '\n' ';')"
}
chk_B9() {
    prep_awk; prep_names
    if [ "$names_ready" = 2 ]; then skip B9 "the Debian name lists in evidence/ are missing"; return; fi
    bads=
    for p in $FREE; do m=$(pk "$(pkfile $p)" | comm -23 - "$T/main.names" | tr '\n' ' '); [ -z "$m" ] || bads="$bads $p:[$m]"; done
    m=$(pk "$(pkfile author)" | comm -23 - "$T/main.names" | tr '\n' ' '); [ -z "$m" ] || bads="$bads author:[$m]"
    m=$(pk "$(pkfile addon-firmware)" | comm -23 - "$T/nff.names" | tr '\n' ' '); [ -z "$m" ] || bads="$bads addon-firmware:[$m]"
    m=$(pk "$(pkfile fullsink)" | comm -23 - "$T/main.names" | comm -23 - "$T/nff.names" | tr '\n' ' '); [ -z "$m" ] || bads="$bads fullsink:[$m]"
    both=$(comm -12 "$T/main.names" "$T/nff.names" | tr '\n' ' ')
    [ -z "$both" ] || bads="$bads (a name is in both components: $both)"
    total=$(cat "$T"/awk/out/*.packages | grep -v -e '^#' -e '^$' | sort -u | wc -l | tr -d ' ')
    [ -z "$bads" ] && ok B9 "all $total distinct names exist in Debian 13.7 in the component the profile claims; main and non-free-firmware do not overlap" \
                   || bad B9 "not in Debian 13.7 where claimed:$bads"
}
chk_B10() {
    prep_awk; prep_names
    if [ "$names_ready" = 2 ]; then skip B10 "the Debian name lists in evidence/ are missing"; return; fi
    bads=
    for p in $FREE; do
        m=$(pk "$(pkfile $p)" | comm -12 - "$T/nff.names" | tr '\n' ' '); [ -z "$m" ] || bads="$bads $p holds non-free firmware: $m"
        grep -qx -e '--archive-areas main' "$T/awk/out/$p.lbflags" || bads="$bads $p.lbflags is not main-only"
        grep -qx -e '--firmware-chroot false' "$T/awk/out/$p.lbflags" && grep -qx -e '--firmware-binary false' "$T/awk/out/$p.lbflags" || bads="$bads $p.lbflags lets live-build add firmware"
    done
    grep -qx -e '--archive-areas main non-free-firmware' "$T/awk/out/fullsink.lbflags" || bads="$bads fullsink.lbflags does not name the firmware component it uses"
    [ -z "$bads" ] && ok B10 "minimal, desktop, homelab and hardened are main-only with firmware off; fullsink names its extra component" || bad B10 "$bads"
}
chk_B11() {
    prep_awk
    if [ ! -r "$EVID/lb-config-options.txt" ]; then skip B11 "evidence/lb-config-options.txt is missing"; return; fi
    grep -v '^#' "$EVID/lb-config-options.txt" | sort -u > "$T/lbopts"
    bads=
    for f in "$T"/awk/out/*.lbflags; do
        grep -v -e '^#' -e '^$' "$f" | while read -r flag val; do
            o=${flag#--}
            grep -qx -- "$o" "$T/lbopts" || echo "$(basename "$f"): $flag is not an lb config option"
            [ -n "$val" ] || echo "$(basename "$f"): $flag has no value"
        done
        d=$(grep -v -e '^#' -e '^$' "$f" | cut -d' ' -f1 | sort | uniq -d | tr '\n' ' '); [ -z "$d" ] || echo "$(basename "$f"): repeated $d"
    done > "$T/b11.out"
    grep -qx -e '--distribution trixie' "$T/awk/out/desktop.lbflags" || echo "desktop.lbflags does not pin trixie" >> "$T/b11.out"
    for f in "$T"/awk/out/*.lbflags; do grep -qx -e '--architecture amd64' "$f" || echo "$(basename "$f") is not amd64 (trixie has no i386 kernel or installer)" >> "$T/b11.out"; done
    [ -s "$T/b11.out" ] && bad B11 "$(head -3 "$T/b11.out" | tr '\n' ';')" || ok B11 "every flag is a real lb config option (from live-build's own option list), none repeated, trixie pinned, amd64 only"
}
chk_B12() {
    prep_awk; bads=
    got=$(grep -v -e '^#' "$T/awk/out/profiles.txt" | cut -d'|' -f1 | tr '\n' ' ')
    [ "$got" = "minimal desktop homelab hardened fullsink " ] || bads="$bads profiles.txt lists [$got]"
    for p in $PROFILES; do [ -s "$(pkfile $p)" ] && [ -s "$T/awk/out/$p.lbflags" ] || bads="$bads $p(missing a file)"; pk "$(pkfile $p)" > "$T/p.$p"; done
    # the shared base (boot, core, token, console groups) is in all five; the console-mouse group is not (graphical profiles have no gpm)
    awk '/^#\+name: g-(boot|core|token|console)$/ { g = 1; next } /^#\+begin_src/ { if (g) inb = 1; next } /^#\+end_src/ { inb = 0; g = 0; next } inb' "$RECIPES" | sort -u > "$T/base.names"
    [ -s "$T/base.names" ] || bads="$bads could not read the base groups from recipes.org"
    for p in $PROFILES; do m=$(comm -23 "$T/base.names" "$T/p.$p" | tr '\n' ' '); [ -z "$m" ] || bads="$bads $p lacks base packages: $m"; done
    for p in minimal desktop homelab hardened; do m=$(comm -23 "$T/p.$p" "$T/p.fullsink" | tr '\n' ' '); [ -z "$m" ] || bads="$bads fullsink lacks $m from $p"; done
    m=$(pk "$(pkfile author)" | comm -23 - "$T/p.fullsink" | tr '\n' ' '); [ -z "$m" ] || bads="$bads fullsink lacks author packages $m"
    m=$(pk "$(pkfile addon-firmware)" | comm -23 - "$T/p.fullsink" | tr '\n' ' '); [ -z "$m" ] || bads="$bads fullsink lacks firmware $m"
