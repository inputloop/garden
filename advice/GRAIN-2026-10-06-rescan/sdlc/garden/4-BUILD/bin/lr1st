#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# lr1st -- LaRder 1 STamp: put the "by permission" mark on a fan work, if and only if permission exists.
#   lr1st [--notice FILE] WORK.txt > WORK-by-permission.txt
# It refuses (exit 1, reason on stderr) unless BOTH hold:
#   1. the notice says "STATUS: IN FORCE";
#   2. FILE.asc, a detached signature, verifies against the author's key ring ($LARDER_AUTHOR_KEYRING).
# The status line is only text anyone can edit; the signature is the real gate.
# The mark text comes from between the watermark markers in the notice, with {AUTHOR} and {VERSION}
# filled in from its header. The mark says the author has not read the work, and the tool never says otherwise.
here=$(dirname "$0")
notice=$here/../author/PERMISSION-NOTICE.md
while [ $# -gt 0 ]; do
    case $1 in
        --notice) [ $# -ge 2 ] || { echo "lr1st: --notice needs a file" >&2; exit 1; }; notice=$2; shift 2 ;;
        -h|--help) sed -n '3,9p' "$0"; exit 0 ;;
        -*) echo "lr1st: unknown option $1 (see -h)" >&2; exit 1 ;;
        *) break ;;
    esac
done
[ $# -eq 1 ] && [ -r "$1" ] || { echo "usage: lr1st [--notice FILE] WORK.txt" >&2; exit 1; }
[ -r "$notice" ] || { echo "lr1st: cannot read the notice $notice" >&2; exit 1; }
status=$(sed -n 's/^STATUS: //p' "$notice" | head -1)
[ "$status" = "IN FORCE" ] || { echo "lr1st: refusing: the notice is '$status', not IN FORCE. No permission exists yet." >&2; exit 1; }
[ -n "${LARDER_AUTHOR_KEYRING:-}" ] && [ -r "$LARDER_AUTHOR_KEYRING" ] ||
    { echo "lr1st: refusing: no author key ring (set LARDER_AUTHOR_KEYRING), so the signature cannot be checked." >&2; exit 1; }
[ -r "$notice.asc" ] || { echo "lr1st: refusing: $notice.asc (the author's signature) is missing." >&2; exit 1; }
command -v gpgv >/dev/null 2>&1 || { echo "lr1st: refusing: gpgv is not installed, so the signature cannot be checked." >&2; exit 1; }
gpgv --keyring "$LARDER_AUTHOR_KEYRING" "$notice.asc" "$notice" >/dev/null 2>&1 ||
    { echo "lr1st: refusing: the signature on the notice does not verify against the author's key ring." >&2; exit 1; }
author=$(sed -n 's/^AUTHOR: //p' "$notice" | head -1)
version=$(sed -n 's/^VERSION: //p' "$notice" | head -1)
mark=$(awk '/^<!-- watermark -->/{f=1;next} /^<!-- \/watermark -->/{f=0} f' "$notice" |
       sed -e "s|{AUTHOR}|$author|g" -e "s|{VERSION}|$version|g")
[ -n "$mark" ] || { echo "lr1st: refusing: the notice has no mark between its watermark markers." >&2; exit 1; }
nsum=$(sha256sum "$notice" | cut -d' ' -f1)
wsum=$(sha256sum "$1" | cut -d' ' -f1)
printf '%s\n(notice sha256 %s)\n\n' "$mark" "$nsum"
cat "$1"
printf '\n--\n%s\n(work sha256 %s)\n' "$mark" "$wsum"
