#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# lr1tg -- LaRder 1 TanGle: tangle recipes.org into out/ without Emacs.
#   lr1tg [-C DIR] FILE.org      write every :tangle target under DIR
#                                (default: the directory holding FILE.org,
#                                which is where org-babel-tangle writes too)
# Prints the paths it wrote. Exit 0 ok, 1 refused (reason on stderr).
# Unknown options are refused, never ignored.
here=$(dirname "$0")
base=
while [ $# -gt 0 ]; do
    case $1 in
        -C) [ $# -ge 2 ] || { echo "lr1tg: -C needs a directory" >&2; exit 1; }
            base=$2; shift 2 ;;
        -h|--help) sed -n '3,9p' "$0"; exit 0 ;;
        -*) echo "lr1tg: unknown option $1 (see -h)" >&2; exit 1 ;;
        *)  break ;;
    esac
done
[ $# -eq 1 ] || { echo "lr1tg: give exactly one .org file (see -h)" >&2; exit 1; }
[ -r "$1" ] || { echo "lr1tg: cannot read $1" >&2; exit 1; }
[ -n "$base" ] || base=$(dirname "$1")
exec awk -v BASE="$base" -f "$here/lr1tg.awk" "$1"
