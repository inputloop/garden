# house.env -- the conventions every tool that writes a date, a name, a licence or a byline reads,
# so each is decided here once.  KEY="VALUE", one per line, sh-sourceable; Python reads the same
# lines (tests/test_ft1mt.py).  Change a value here; re-mint (bin/ft1mt mint); never retype it.
#
# Times: tools write UTC, always.  LOCAL_TZ is the person's own zone, used once, when a time he
# gives in his local terms is turned into UTC (bin/ft1mt utc "YYYY-MM-DD HH:MM").  Derived from his
# stated home (Minnesota); change it here if that is wrong.
AUTHOR_NAME="Corwin Brust"
AUTHOR_EMAIL="corwin@bru.st"
HOLDER="Corwin Brust <corwin@bru.st> and Contributors"
LOCAL_TZ="America/Chicago"
PROSE_LICENCE="CC-BY-SA4"
PROSE_LICENCE_URL="https://creativecommons.org/licenses/by-sa/4.0/"
CODE_LICENCE="GPL-3.0-or-later"
LINK_LICENCE="LGPL-3.0-or-later"
PERSONA="Mentat"
PRINCIPAL="Corwin"
MODEL="claude-opus-5-5"
SIGN_KEY="ECE77CF417C76C1ACFCE7C2B5B6135511580F007"
