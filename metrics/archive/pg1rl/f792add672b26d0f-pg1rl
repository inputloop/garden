def main(argv):
    if not argv or argv[0] in ("-h", "--help"): die("usage: pg1rl --build TRAITS.tsv NEWS.tsv TEMPLATE.md --seed N | --sources TRAITS.tsv | --lint GRID.md | --roll GRID.md --seed N [--traits K] [--jumbled] | --json GRID.md | --html GRID.md | --prove-red")
    cmd = argv[0]
    if cmd == "--prove-red":
        bad = {"tables": {}, "jumbled": {}, "news": {"items": [], "ordered": None, "randomized": None}, "index": [["BIAS"] * 6 for _ in range(6)], "sections": []}
        f = lint(bad); print("PASS: pg1rl FAULTs a grid whose index carries no numbers (%d faults)" % len(f) if f else "FAIL: no fault on an empty grid"); sys.exit(0 if f else 1)
    if cmd == "--sources":
        if len(argv) < 2: die("--sources TRAITS.tsv")
        sys.stdout.write(sources_md(argv[1])); return
    if cmd == "--build":
        if len(argv) < 6 or argv[4] != "--seed": die("--build TRAITS.tsv NEWS.tsv TEMPLATE.md --seed N")
        sys.stdout.write(build(argv[1], argv[2], argv[3], int(argv[5]))); return
    if len(argv) < 2: die("need GRID.md")
    spec = parse(open(argv[1], encoding="utf-8").read())
    if cmd == "--lint":
        f = lint(spec)
        for x in f: print("FAULT  %s" % x)
        print("pg1rl lint: %d table(s), %d jumbled, %d news items, index %s, %d tab(s) -- %s" % (len(spec["tables"]), len(spec["jumbled"]), len(spec["news"]["items"]), "ok" if spec["index"] else "MISSING", len(spec["sections"]), "FAULT %d" % len(f) if f else "OK"))
        sys.exit(1 if f else 0)
    if cmd == "--json": print(json.dumps(spec, indent=1, ensure_ascii=False)); return
    if cmd == "--roll":
        seed = None; k = 4; jumbled = False; i = 2
        while i < len(argv):
            if argv[i] == "--seed": seed = int(argv[i + 1]); i += 2
            elif argv[i] == "--traits": k = int(argv[i + 1]); i += 2
            elif argv[i] == "--jumbled": jumbled = True; i += 1
            else: die("unknown arg %s" % argv[i])
        if seed is None: die("--seed is required (a roll without a printed seed cannot be re-read)")
        if lint(spec): die("spec has FAULTs; run --lint first", 1)
        print(trace_text(roll(spec, seed, k, jumbled))); return
    if cmd == "--html": sys.stdout.write(html_view(spec, open(argv[1], encoding="utf-8").read())); return
    if cmd == "--artifact": sys.stdout.write(html_view(spec, open(argv[1], encoding="utf-8").read(), artifact=True)); return
    die("unknown command %s" % cmd)

if __name__ == "__main__":
    main(sys.argv[1:])
