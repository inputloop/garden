#!/bin/sh
# ju1as -- JUNCTURE 1 ASSEMBLE.  A crossing-point, computed from its parts.
#
# Copyright (C) 2026 Corwin Brust <corwin@bru.st>.  Co-authored by Mentat (Claude, in Cowork).
# GPL-3.0-or-later.  READ-ONLY with respect to source material: it never writes inside the forest
# it measures except into the juncture room's own derived files, which it owns.
#
# ---------------------------------------------------------------------------------------------
# THE RULE THIS TOOL EXISTS TO SERVE, in Corwin's words, 2026-09-17:
#
#   "...so that as you begin to build up integral fortress-palace in C4 those are not static
#    hunks of reference data but rather bits assembled -- and cheaply so when few parts have
#    moved recently."
#
# A JUNCTURE is a named crossing-point where several parts meet: a word, a fact, an instrument,
# a gate, a memory, a room, a spec.  It is DERIVED.  Nobody hand-maintains one.  Reading one is
# reading an assembly, and the assembly carries its own receipt.
#
# CHEAPNESS IS NOT A FEELING, IT IS A MEASUREMENT, AND THIS PROGRAM DOES NOT TAKE IT.  bin/at1pl
# already answers "which constituents moved since the meta was collected" and ships 39/39 plus
# --prove-red.  ju1as calls it and obeys its verdict:
#
#   at1pl says PULL  ->  something moved  ->  ASSEMBLED, and the reason names what moved.
#   at1pl says HOLD  ->  nothing moved    ->  CACHED,    and the cached assembly stands.
#
# DOUBLE ENTRY, MECHANICAL RATHER THAN CUSTOMARY.  Every link is posted at BOTH ends in the same
# run: the juncture's model names its parts, and <name>.backlinks.tsv names, for each part, the
# juncture that cites it.  `ju1as balance` is the trial balance -- spec, meta and back-links must
# agree row for row, and the model must contain each part's path literally.  A convention that
# says "remember to record it at the other end" is a convention.  A run that writes both ends and
# a balance that goes OFF when they disagree is bookkeeping.
#
# A SPEC IS DATA AND DATA THAT CAN RUN IS NOT DATA.  Same discipline as profile.signing: every
# field is read with sed, nothing is sourced, nothing is eval'd, no field ever reaches a shell as
# a command.  A part path may not be absolute and may not contain "..": a spec names things inside
# its declared root or it names nothing.  Proved by --prove-red and by tests/ju1as-tests.sh.
#
# IT ALWAYS EXITS 0 WHEN IT COULD MEASURE.  Exit 2 is usage and environment only -- no spec, no
# at1pl, an unreadable root.  An assembler that can fail a build is a gate, and a gate is a thing
# people learn to route around.
#
# ---------------------------------------------------------------------------------------------
# usage:
#   ju1as assemble    [SPEC...] [-r ROOT] [-o DIR] [--force]   reassemble what moved; print why
#   ju1as check       [SPEC...] [-r ROOT] [-o DIR] [--tsv]     freshness only; writes nothing
#   ju1as balance     [SPEC...] [-r ROOT] [-o DIR] [--tsv]     trial balance, both ends of each link
#   ju1as ingredients [SPEC...] [--tsv]                        the open-question register, n-way
#   ju1as --prove-red                                          plant every fault; show them all red
#   ju1as -h                                                   this header
#
# With no SPEC, every *.juncture in <c4>/q/junctures is used.  A default that makes you name the
# obvious thing is a default that charges rent (PREFERENCES.md, the Emacs rule).
#
# SPEC FORMAT -- <name>.juncture, flat key=value plus tab-separated rows:
#   juncture=<bare lower-case word>        required, and it is the file's own name
#   title=<one line>                       required
#   root=c4|estate                         required; where part paths are relative to
#   say=<one paragraph>                    0+, in order, rendered as the preamble
#   falsifier=<one line>                   0+, what would make this juncture wrong
#   part  <TAB> PATH <TAB> ROLE <TAB> WHAT IT BRINGS
#   ask   <TAB> ID <TAB> QUESTION <TAB> WHAT ANSWERING UNBLOCKS <TAB> COST OF LEAVING IT
#   ruled <TAB> ID <TAB> THE RULING <TAB> WHO RULED <TAB> WHEN
#
# A `ruled` row does NOT delete the `ask` it answers.  Both ends stay, the way both ends of a
# link stay: the register then shows the question AND the answer, and a reader can see what was
# asked as well as what was decided.  This program still refuses to ANSWER an ingredient -- a
# `ruled` row is the keeper's sentence, carried with the name of whoever ruled and the date, and
# an instrument that wrote one on its own initiative would be guessing in a format that looks
# like a ruling.  The row is data like every other field here: read with sed and awk, never
# sourced, never evaluated.
#
# Two parts are added by this program and never written in a spec, because they are constituents
# of the ASSEMBLY rather than of the MEANING: the spec itself, and this program.  Edit either and
# the juncture is stale, which is true and was worth making mechanical.
#
# WHAT IT WRITES, all beside the spec (-o moves them):
#   <name>.md             the assembled juncture
#   <name>.meta.tsv       at1pl's measurement of the forest at assembly time
#   <name>.backlinks.tsv  the other end of every link
# ---------------------------------------------------------------------------------------------

set -u
export LC_ALL=C
me=ju1as
TAB=$(printf '\t')
die() { printf '%s: %s\n' "$me" "$*" >&2 ; exit 2 ; }

TMPD=${TMPDIR:-/tmp}/$me.$$
mkdir -p "$TMPD" || die "cannot make $TMPD"
trap 'rm -rf "$TMPD"' EXIT HUP INT TERM

c4root() { CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd ; }

find_at1pl() {
	d=$(dirname -- "$0")
	[ -f "$d/at1pl" ] && { printf '%s\n' "$d/at1pl" ; return 0 ; }
	r=$(c4root) && [ -f "$r/bin/at1pl" ] && { printf '%s\n' "$r/bin/at1pl" ; return 0 ; }
	command -v at1pl 2>/dev/null && return 0
	return 1
}

# ---- spec reading.  sed only.  Nothing here can execute. --------------------------------------
f_one()  { sed -n "s/^$1=//p" "$2" 2>/dev/null | head -1 ; }
f_many() { sed -n "s/^$1=//p" "$2" 2>/dev/null ; }
f_rows() { grep "^$1$TAB" "$2" 2>/dev/null || : ; }

safe_rel() {   # a part path is relative, and it does not climb
	case "${1:-}" in
		'') return 1 ;;
		/*) return 1 ;;
		*..*) return 1 ;;
	esac
	return 0
}

md_cell() { printf '%s' "$1" | sed 's/|/\\|/g' ; }

# THE SAME TREE UNDER TWO NAMES, SETTLED THE WAY q/words/pub.md SETTLED IT: BY INODE.
# This session reaches the c4 tree as $HOME/mnt/c4 and as $HOME/mnt/claude/c4, one inode, two
# spellings. $0 arrives by whichever spelling was typed, so a plain prefix-strip against the
# verified root silently drops the two auto-parts -- the spec and this program -- and a juncture
# quietly stops watching the files it is assembled from. A fourth name is not a fourth shelf:
# ask the filesystem rather than the name.
relocate() {   # $1 = an absolute path.  Prints it relative to $JROOT, or fails.
	p=$1
	r=${p#"$JROOT"/}
	[ "$r" != "$p" ] && { printf '%s\n' "$r" ; return 0 ; }
	c=$(c4root) || return 1
	sub=${p#"$c"/}
	[ "$sub" = "$p" ] && return 1
	ci=$(stat -c %i "$c" 2>/dev/null) || ci=$(stat -f %i "$c" 2>/dev/null) || return 1
	[ -n "$ci" ] || return 1
	for k in "$JROOT"/*/ ; do
		[ -d "$k" ] || continue
		ki=$(stat -c %i "$k" 2>/dev/null) || ki=$(stat -f %i "$k" 2>/dev/null) || continue
		if [ "$ki" = "$ci" ]; then
			printf '%s/%s\n' "$(basename -- "${k%/}")" "$sub" ; return 0
		fi
	done
	return 1
}

OPT_ROOT= ; OPT_OUT= ; OPT_TSV=0 ; OPT_FORCE=0
ROOTSTATE=UNVERIFIED

# A ROOT IS ONLY A ROOT IF IT CAN SHOW ITS MARKER.
#
# OBSERVED, 2026-09-17, and it is the whole reason this exists.  This session mounts the c4 tree
# at BOTH $HOME/mnt/c4 and $HOME/mnt/claude/c4 -- the same inode, two spellings.  Deriving the
# estate root as "the parent of the c4 root" therefore gives $HOME/mnt, which holds a directory
# called c4 and NOTHING ELSE the estate has.  The first assembly of q/junctures/signing.juncture
# under that root reported four parts GONE that are on the disk and readable.  A wrong root does
# not announce itself; it reports absence, confidently, which is the failure c4/CLAUDE.md:43 was
# minted over and the RECIPE's rule (a name without a root is not a pointer) states in general.
#
# So a spec may carry `rootmark=` lines: relative paths that MUST exist under the real root.  The
# candidate roots are the c4 root's ancestors AND their immediate children -- the sibling case is
# the one an ancestor walk cannot reach, and it is exactly the case here.  The first candidate
# that shows every marker wins.  A spec with no markers still resolves, and is reported
# UNVERIFIED rather than clean -- a different outcome, and deliberately not a quieter one.
#
# The walk is bounded at 4 levels up.  That is a CHOSEN BOUND, not a measurement: 4 is one of the
# house guess numbers and it is being used as one.
root_candidates() {
	c=$(c4root) || return 1
	p=$(CDPATH= cd -- "$c/.." 2>/dev/null && pwd) || return 1
	i=0
	while [ "$i" -lt 4 ]; do
		printf '%s\n' "$p"
		for k in "$p"/*/ ; do
			[ -d "$k" ] || continue
			( CDPATH= cd -- "$k" 2>/dev/null && pwd )
		done
		[ "$p" = / ] && break
		n=$(CDPATH= cd -- "$p/.." 2>/dev/null && pwd) || break
		[ "$n" = "$p" ] && break
		p=$n ; i=$((i+1))
	done
}

root_ok() {   # $1 = a candidate directory.  False when a marker is missing, or when none is set.
	n=0
	while IFS= read -r m; do
		[ -n "$m" ] || continue
		n=$((n+1))
		[ -e "$1/$m" ] || return 1
	done < "$TMPD/marks"
	[ "$n" -gt 0 ]
}

resolve_root() {   # $1 = the spec's root word.  -r wins absolutely and is not marker-checked.
	if [ -n "$OPT_ROOT" ]; then
		CDPATH= cd -- "$OPT_ROOT" 2>/dev/null && pwd && return 0
		return 1
	fi
	case "$1" in
		c4)     c4root ; return $? ;;
		estate) : ;;
		*)      return 1 ;;
	esac
	root_candidates > "$TMPD/cands" 2>/dev/null || return 1
	first=
	while IFS= read -r d; do
		[ -n "$d" ] || continue
		[ -n "$first" ] || first=$d
		if root_ok "$d"; then printf '%s\n' "$d" ; return 0 ; fi
	done < "$TMPD/cands"
	[ -n "$first" ] && { printf '%s\n' "$first" ; return 0 ; }
	return 1
}

default_specs() {
	r=$(c4root) || return 1
	d="$r/q/junctures"
	[ -d "$d" ] || return 1
	ls "$d"/*.juncture 2>/dev/null
}

# ---- load one spec into globals ---------------------------------------------------------------
# Sets: SPEC SPECABS JNAME JTITLE JROOTW JROOT OUTDIR MODEL META BACKL SPECREL SELFREL
spec_load() {
	SPEC=$1
	[ -f "$SPEC" ] || die "no spec at $SPEC"
	sd=$(CDPATH= cd -- "$(dirname -- "$SPEC")" 2>/dev/null && pwd) || die "cannot reach $(dirname -- "$SPEC")"
	SPECABS="$sd/$(basename -- "$SPEC")"

	JNAME=$(f_one juncture "$SPEC")
	JTITLE=$(f_one title "$SPEC")
	JROOTW=$(f_one root "$SPEC")
	[ -n "$JNAME" ]  || die "$SPEC: needs a juncture= line"
	[ -n "$JTITLE" ] || die "$SPEC: needs a title= line"
	[ -n "$JROOTW" ] || die "$SPEC: needs a root= line (c4 or estate)"
	case "$JNAME" in
		*[!a-z0-9-]*) die "$SPEC: juncture name '$JNAME' is not a bare lower-case word" ;;
	esac
	f_many rootmark "$SPEC" > "$TMPD/marks"
	JROOT=$(resolve_root "$JROOTW") || die "$SPEC: root '$JROOTW' is not c4, not estate, and -r named nothing reachable"
	if root_ok "$JROOT"; then ROOTSTATE=VERIFIED; else ROOTSTATE=UNVERIFIED; fi
	if [ "$ROOTSTATE" = UNVERIFIED ] && [ -s "$TMPD/marks" ]; then
		printf 'UNVERIFIED  %-12s no candidate root showed every rootmark; using %s\n' "$JNAME" "$JROOT" >&2
		while IFS= read -r m; do
			[ -n "$m" ] || continue
			[ -e "$JROOT/$m" ] || printf '            missing marker: %s\n' "$m" >&2
		done < "$TMPD/marks"
	fi

	OUTDIR=${OPT_OUT:-$sd}
	[ -d "$OUTDIR" ] || die "no output directory at $OUTDIR"
	MODEL="$OUTDIR/$JNAME.md"
	META="$OUTDIR/$JNAME.meta.tsv"
	BACKL="$OUTDIR/$JNAME.backlinks.tsv"

	SPECREL=$(relocate "$SPECABS") || SPECREL=
	selfabs=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)/$(basename -- "$0")
	SELFREL=$(relocate "$selfabs") || SELFREL=
	[ -n "$SPECREL" ] || printf 'NOTE        %-12s the spec is not under %s; it is not watched as a part of itself\n' "$JNAME" "$JROOT" >&2
	[ -n "$SELFREL" ] || printf 'NOTE        %-12s bin/ju1as is not under %s; the assembler is not watched\n' "$JNAME" "$JROOT" >&2
}

# ---- the manifest at1pl walks ------------------------------------------------------------------
build_manifest() {
	f_rows part "$SPEC" > "$TMPD/partrows"
	: > "$TMPD/manifest" ; : > "$TMPD/badpaths"
	nparts=0
	while IFS="$TAB" read -r kw p role note || [ -n "${kw:-}" ]; do
		[ "${kw:-}" = part ] || continue
		if safe_rel "${p:-}"; then
			printf '%s\t%s\n' "$p" "${role:--}" >> "$TMPD/manifest"
			nparts=$((nparts+1))
		else
			printf '%s\t%s\n' "${p:-(empty)}" "absolute or climbing -- a spec names things inside its root" >> "$TMPD/badpaths"
		fi
	done < "$TMPD/partrows"
	[ -n "$SPECREL" ] && { printf '%s\t%s\n' "$SPECREL" "spec" >> "$TMPD/manifest" ; nparts=$((nparts+1)) ; }
	[ -n "$SELFREL" ] && { printf '%s\t%s\n' "$SELFREL" "assembler" >> "$TMPD/manifest" ; nparts=$((nparts+1)) ; }
	NPARTS=$nparts
	[ "$NPARTS" -gt 0 ] || die "$SPEC: no usable part rows"
}

# ---- freshness, entirely at1pl's answer ---------------------------------------------------------
# Sets VERDICT (PULL|HOLD) WHY, and leaves per-atom rows in $TMPD/check.tsv when there was a meta.
freshness() {
	: > "$TMPD/check.tsv"
	if [ ! -f "$META" ]; then
		VERDICT=PULL ; WHY="no meta beside this spec: this juncture has never been assembled here"
		return 0
	fi
	# The meta records the root it was collected under.  A mount table is not a disk, so rebase a
	# COPY onto the root resolved now, and hand at1pl the copy.  The meta on disk is not touched.
	sed "s|^# root: .*|# root: $JROOT|" "$META" > "$TMPD/meta.rebased" 2>/dev/null \
		|| { VERDICT=PULL ; WHY="the meta beside this spec could not be read" ; return 0 ; }
	"$AT1PL" check "$TMPD/meta.rebased" "$MODEL" --tsv > "$TMPD/check.tsv" 2>"$TMPD/check.err" || {
		VERDICT=PULL ; WHY="at1pl refused this meta: $(head -1 "$TMPD/check.err" 2>/dev/null)" ; return 0 ; }
	# at1pl already skips the model and the meta as non-constituents of THEMSELVES.  This room
	# writes three derived files per juncture -- model, meta, back-links -- and holds a README and
	# an ingredient register besides, so the same principle has to be applied the same number of
	# times.  A file that lives in the juncture room and is NOT named as a part of this juncture is
	# an OUTPUT of the assembly, never a constituent of the meaning, and counting one would make
	# every juncture permanently stale the instant it was first assembled.  OBSERVED, on the
	# --prove-red fixture, 2026-09-17: without this the second run reassembled and the cheap case
	# never happened.  Nothing else is discounted; every discounted row is an UNRECORDED row from
	# this room's own directory and nowhere else.
	room=
	if [ -n "${SPECREL:-}" ]; then
		room=$(printf '%s' "$SPECREL" | sed 's|/[^/]*$||')
		[ "$room" = "$SPECREL" ] && room=.
	fi
	[ -n "$room" ] || room='NOROOMDISCOUNTPOSSIBLE'
	awk -F"$TAB" -v R="$room" -v PL="$TMPD/manifest" '
		BEGIN { while ((getline l < PL) > 0) { split(l, a, "\t"); part[a[1]]=1 } }
		$1=="ATOM" && $2=="UNRECORDED" {
			p=$3 ; d=p ; if (sub(/\/[^\/]*$/, "", d) == 0) d="." ;
			if (d==R && !(p in part)) next
		}
		{ print }
	' "$TMPD/check.tsv" > "$TMPD/check.kept" && mv "$TMPD/check.kept" "$TMPD/check.tsv"

	# at1pl's own aggregation rule, applied to the rows that survived that one exclusion.  It is
	# restated here rather than read off at1pl's TOTAL line BECAUSE of the exclusion: taking the
	# TOTAL and then quietly disagreeing with the rows under it would be the worse of the two.
	moved=$(awk -F"$TAB"   '$1=="ATOM" && ($2=="NEWER"||$2=="DRIFT"||$2=="GONE"||$2=="UNRECORDED"){n++} END{print n+0}' "$TMPD/check.tsv")
	untimed=$(awk -F"$TAB" '$1=="ATOM" && $2=="UNTIMED"{n++} END{print n+0}' "$TMPD/check.tsv")
	mrow=$(awk -F"$TAB"    '$1=="MODEL"{print $2; exit}' "$TMPD/check.tsv")
	if   [ "${mrow:-}" = ABSENT ]; then VERDICT=PULL ; WHY="the assembled juncture is not on disk at all"
	elif [ "${moved:-0}" -gt 0 ]; then  VERDICT=PULL ; WHY="$moved part(s) moved since the last assembly"
	elif [ "${mrow:-}" = OLDER ];  then VERDICT=PULL ; WHY="every part matches, but the assembled file predates the parts it describes"
	elif [ "${untimed:-0}" -gt 0 ]; then VERDICT=HOLD ; WHY="nothing changed by sha; $untimed part(s) could not be dated on this host"
	else VERDICT=HOLD ; WHY="nothing among the $NPARTS parts has moved since the last assembly"
	fi
	return 0
}

prior_verdict() {   # $1 = path.  What at1pl said about this atom in the check that triggered us.
	[ -s "$TMPD/check.tsv" ] || { printf 'FIRST\n' ; return ; }
	v=$(awk -F"$TAB" -v P="$1" '$1=="ATOM" && $3==P {print $2; exit}' "$TMPD/check.tsv")
	[ -n "$v" ] || v=FIRST
	printf '%s\n' "$v"
}

# ---- n-way cross-reference: which sibling specs raise the same ask id ---------------------------
also_raised_by() {   # $1 = ask id, $2 = this juncture's name
	d=$(dirname -- "$SPECABS")
	out=
	for s in "$d"/*.juncture; do
		[ -f "$s" ] || continue
		n=$(f_one juncture "$s") ; [ -n "$n" ] || continue
		[ "$n" = "$2" ] && continue
		if awk -F"$TAB" -v I="$1" '$1=="ask" && $2==I {found=1} END{exit !found}' "$s"; then
			out="${out:+$out, }$n"
		fi
	done
	printf '%s\n' "${out:--}"
}

# ---- assemble -----------------------------------------------------------------------------------
assemble_one() {
	when=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)
	day=$(date -u +%Y-%m-%d 2>/dev/null || echo unknown)

	"$AT1PL" collect "$TMPD/manifest" -r "$JROOT" -m "$MODEL" > "$TMPD/meta.new" \
		|| die "at1pl collect failed for $JNAME"
	# A part at1pl could not open at collect time is not a stale part, it is an UNFOUNDED one --
	# at1pl's own word for a model derived from a file that is not there. It is counted here, put
	# in the assembled file, and said out loud on stdout, because the one thing a wrong root does
	# is report absence confidently.
	NMISS=$(awk -F"$TAB" '$2=="MISSING-AT-COLLECT"{n++} END{print n+0}' "$TMPD/meta.new")

	{
	printf '# juncture · %s\n\n' "$JTITLE"
	printf '> **DERIVED — do not hand-edit.** This file is assembled from `%s` by `bin/ju1as`,\n' "${SPECREL:-$SPEC}"
	printf '> which reassembles only when `bin/at1pl` says a part moved. Assembled %s.\n' "$when"
	printf '> Regenerate: `sh bin/ju1as assemble q/junctures/%s.juncture`\n\n' "$JNAME"

	f_many say "$SPEC" | while IFS= read -r line; do [ -n "$line" ] && printf '%s\n\n' "$line"; done

	printf -- '---\n\n'
	printf '## §1 · FRESHNESS — OBSERVED\n\n'
	printf 'Measured by `bin/at1pl`, not by this program. Its verdicts are the only freshness\n'
	printf 'this file has, and they were taken against the meta from the previous assembly.\n\n'
	printf '```sh\n'
	printf 'sh bin/ju1as check q/junctures/%s.juncture\n' "$JNAME"
	printf 'sh bin/at1pl check q/junctures/%s.meta.tsv q/junctures/%s.md --all\n' "$JNAME" "$JNAME"
	printf '```\n\n'
	printf '| | |\n|---|---|\n'
	printf '| verdict that triggered this assembly | **%s** |\n' "$VERDICT"
	printf '| reason at1pl gave | %s |\n' "$(md_cell "$WHY")"
	printf '| root the parts are named against | `%s` (`root=%s`, %s) |\n' "$JROOT" "$JROOTW" "$ROOTSTATE"
	printf '| parts at1pl could not open | %s |\n' "$NMISS"
	printf '| parts measured | %s |\n' "$NPARTS"
	printf '| assembled at | %s |\n\n' "$when"
	printf 'What CACHED would have meant: at1pl reporting HOLD, every part matching its recorded\n'
	printf 'sha with no mtime advance, and this file standing unchanged at zero cost. That is the\n'
	printf 'ordinary case and it is the one the design is for.\n\n'

	printf '## §2 · PARTS — %s, each recorded at both ends\n\n' "$NPARTS"
	printf '| part | role | what it brings | sha256 | bytes | since last assembly |\n'
	printf '|---|---|---|---|---|---|\n'
	grep -v '^#' "$TMPD/meta.new" | grep -v '^[[:space:]]*$' | while IFS="$TAB" read -r p sha by mt role wh; do
		note=$(awk -F"$TAB" -v P="$p" '$1=="part" && $2==P {print $4; exit}' "$TMPD/partrows")
		case "$role" in
			spec)      note="this juncture's own spec — a constituent of the assembly, not of the meaning" ;;
			assembler) note="the program that assembles this file — edit it and every juncture is stale" ;;
		esac
		printf '| `%s` | %s | %s | `%s` | %s | %s |\n' \
			"$p" "$(md_cell "$role")" "$(md_cell "${note:--}")" "$(printf '%s' "$sha" | cut -c1-12)" "$by" "$(prior_verdict "$p")"
	done
	printf '\n*`since last assembly` is at1pl'"'"'s per-atom verdict from the check that triggered this\n'
	printf 'assembly: `OK` nothing happened · `TOUCHED` re-saved, same bytes · `NEWER` advanced ·\n'
	printf '`DRIFT` changed without advancing · `GONE` no longer there · `FIRST` no prior meta.*\n\n'

	printf '## §3 · BACK-LINKS — the other end of every link above\n\n'
	printf 'Each of the %s links is posted twice by one run: once here, once in\n' "$NPARTS"
	printf '`%s.backlinks.tsv`. That is the double entry, and it is checkable:\n\n' "$JNAME"
	printf '```sh\n'
	printf 'sh bin/ju1as balance q/junctures/%s.juncture      # spec, meta and back-links must agree\n' "$JNAME"
	printf '```\n\n'
	printf 'A part that wants to carry its own half — *cited by juncture X* — reads it out of the\n'
	printf 'register rather than storing a copy that can go stale:\n\n'
	printf '```sh\n'
	printf 'grep -h "^c4/bin/at1pl\t" q/junctures/*.backlinks.tsv | cut -f2\n'
	printf '```\n\n'

	f_rows ask "$SPEC" > "$TMPD/askrows"
	f_rows ruled "$SPEC" > "$TMPD/ruledrows"
	nask=$(grep -c . "$TMPD/askrows" 2>/dev/null) ; nask=${nask:-0}
	nrul=$(grep -c . "$TMPD/ruledrows" 2>/dev/null) ; nrul=${nrul:-0}
	printf '## §4 · INGREDIENTS — %s question(s), %s answered by a ruling\n\n' "$nask" "$nrul"
	if [ "$nask" -gt 0 ]; then
		printf '| id | state | question | answering it unblocks | cost of leaving it | also raised by |\n'
		printf '|---|---|---|---|---|---|\n'
		while IFS="$TAB" read -r kw id q unb cost || [ -n "${kw:-}" ]; do
			[ "${kw:-}" = ask ] || continue
			st=OPEN ; awk -F"$TAB" -v I="$id" '$1=="ruled" && $2==I' "$SPEC" | grep -q . && st=RULED
			printf '| **%s** | %s | %s | %s | %s | %s |\n' \
				"$id" "$st" "$(md_cell "${q:--}")" "$(md_cell "${unb:--}")" "$(md_cell "${cost:--}")" "$(md_cell "$(also_raised_by "$id" "$JNAME")")"
		done < "$TMPD/askrows"
		printf '\nThe same id names the same question in every juncture that raises it. The register\n'
		printf 'that collects them all is `q/junctures/INGREDIENTS.md`, derived by\n'
		printf '`sh bin/ju1as ingredients`.\n\n'
		if [ "$nrul" -gt 0 ]; then
			printf 'Answered here, and the answer is written in the spec rather than in the register:\n\n'
			while IFS="$TAB" read -r kw id rul who when || [ -n "${kw:-}" ]; do
				[ "${kw:-}" = ruled ] || continue
				printf -- '- **%s** — %s\n  *(%s, %s)*\n' "$id" "${rul:--}" "${who:--}" "${when:--}"
			done < "$TMPD/ruledrows"
			printf '\nA ruling does not delete the question. Both ends stay, so a later reader sees what\n'
			printf 'was asked as well as what was decided.\n\n'
		fi
	else
		printf 'None recorded in the spec. That is a claim, not an absence: it says this crossing\n'
		printf 'raised no question this pass, and a later pass may add `ask` rows.\n\n'
	fi

	f_many falsifier "$SPEC" > "$TMPD/fals"
	nfal=$(grep -c . "$TMPD/fals" 2>/dev/null) ; nfal=${nfal:-0}
	printf '## §5 · FALSIFIERS\n\n'
	if [ "$nfal" -gt 0 ]; then
		while IFS= read -r l; do [ -n "$l" ] && printf -- '- %s\n' "$l"; done < "$TMPD/fals"
	else
		printf -- '- This spec ships no falsifier, which is itself the fault: a juncture with no way\n'
		printf '  to be wrong is a claim nobody can check. Add `falsifier=` lines to `%s`.\n' "${SPECREL:-$SPEC}"
	fi
	printf '\n'

	printf '## §6 · HOW THIS WAS MADE\n\n'
	printf '```sh\n'
	printf 'cd %s\n' "$JROOT"
	printf 'sh c4/bin/ju1as assemble c4/q/junctures/%s.juncture\n' "$JNAME"
	printf '```\n\n'
	printf 'Read-only with respect to everything in §2 except this room'"'"'s own derived files\n'
	printf '(`%s.md`, `%s.meta.tsv`, `%s.backlinks.tsv`). The spec is data: `bin/ju1as` reads every\n' "$JNAME" "$JNAME" "$JNAME"
	printf 'field with `sed`, sources nothing and evaluates nothing, and `tests/ju1as-tests.sh`\n'
	printf 'proves a spec cannot run — the same property `tests/ca1sp-tests.sh` proves of a profile.\n'
	} > "$TMPD/model.md"

	cp "$TMPD/model.md" "$MODEL" || die "cannot write $MODEL"
	cp "$TMPD/meta.new" "$META" || die "cannot write $META"

	{
	printf '# JUNCTURE BACKLINKS v1 -- the other end of every link %s posted.\n' "$JNAME"
	printf '# root: %s\n' "$JROOT"
	printf '# juncture: %s\n' "$JNAME"
	printf '# model: %s\n' "$JNAME.md"
	printf '# posted: %s\n' "$when"
	printf '# columns: PART\tJUNCTURE\tROLE\tPOSTED\n'
	grep -v '^#' "$TMPD/meta.new" | grep -v '^[[:space:]]*$' | while IFS="$TAB" read -r p sha by mt role wh; do
		printf '%s\t%s\t%s\t%s\n' "$p" "$JNAME" "$role" "$day"
	done
	} > "$BACKL" || die "cannot write $BACKL"

	if [ -s "$TMPD/badpaths" ]; then
		while IFS="$TAB" read -r p why; do
			printf 'REFUSED     %s\n            %s\n' "$p" "$why"
		done < "$TMPD/badpaths"
	fi
	return 0
}

# ---- commands -------------------------------------------------------------------------------------
cmd_assemble() {
	for s in "$@"; do
		spec_load "$s" ; build_manifest ; freshness
		if [ "$VERDICT" = PULL ] || [ "$OPT_FORCE" = 1 ]; then
			[ "$OPT_FORCE" = 1 ] && [ "$VERDICT" = HOLD ] && WHY="nothing moved; --force asked for it anyway"
			assemble_one
			printf 'ASSEMBLED   %-12s %s parts -- %s\n' "$JNAME" "$NPARTS" "$WHY"
			[ "${NMISS:-0}" -gt 0 ] && printf '              UNFOUNDED   %s part(s) were not openable at collect; the assembly names them\n' "$NMISS"
			[ "$ROOTSTATE" = VERIFIED ] || printf '              UNVERIFIED  the root showed no marker; add rootmark= lines to the spec\n'
			if [ -s "$TMPD/check.tsv" ]; then
				awk -F"$TAB" '$1=="ATOM" && $2!="OK" && $2!="TOUCHED" {printf "              %-11s %s\n", $2, $3}' "$TMPD/check.tsv"
			fi
		else
			printf 'CACHED      %-12s %s parts -- %s\n' "$JNAME" "$NPARTS" "$WHY"
		fi
	done
	return 0
}

cmd_check() {
	[ "$OPT_TSV" = 1 ] && printf 'juncture\tverdict\tparts\twhy\n'
	for s in "$@"; do
		spec_load "$s" ; build_manifest ; freshness
		if [ "$OPT_TSV" = 1 ]; then
			printf '%s\t%s\t%s\t%s\n' "$JNAME" "$VERDICT" "$NPARTS" "$WHY"
		else
			case "$VERDICT" in
				PULL) printf 'MOVED       %-12s %s parts -- %s\n' "$JNAME" "$NPARTS" "$WHY" ;;
				*)    printf 'STILL       %-12s %s parts -- %s\n' "$JNAME" "$NPARTS" "$WHY" ;;
			esac
		fi
	done
	return 0
}

cmd_balance() {
	[ "$OPT_TSV" = 1 ] && printf 'juncture\tstate\tspec_parts\tmeta_rows\tbacklink_rows\tin_model\tnote\n'
	for s in "$@"; do
		spec_load "$s" ; build_manifest
		awk -F"$TAB" '{print $1}' "$TMPD/manifest" | sort -u > "$TMPD/b.spec"
		if [ -f "$META" ]; then grep -v '^#' "$META" | grep -v '^[[:space:]]*$' | awk -F"$TAB" '{print $1}' | sort -u > "$TMPD/b.meta"
		else : > "$TMPD/b.meta" ; fi
		if [ -f "$BACKL" ]; then grep -v '^#' "$BACKL" | grep -v '^[[:space:]]*$' | awk -F"$TAB" '{print $1}' | sort -u > "$TMPD/b.back"
		else : > "$TMPD/b.back" ; fi
		ns=$(grep -c . "$TMPD/b.spec" 2>/dev/null) ; ns=${ns:-0}
		nm=$(grep -c . "$TMPD/b.meta" 2>/dev/null) ; nm=${nm:-0}
		nb=$(grep -c . "$TMPD/b.back" 2>/dev/null) ; nb=${nb:-0}

		note= ; state=BALANCED
		[ -f "$MODEL" ] || { state=OFF ; note="no model at $MODEL" ; }
		[ -f "$META" ]  || { state=OFF ; note="${note:+$note; }no meta at $META" ; }
		[ -f "$BACKL" ] || { state=OFF ; note="${note:+$note; }no back-links at $BACKL" ; }
		if ! cmp -s "$TMPD/b.spec" "$TMPD/b.meta"; then
			state=OFF ; note="${note:+$note; }spec and meta name different parts: $(comm -3 "$TMPD/b.spec" "$TMPD/b.meta" | tr -d "$TAB" | tr '\n' ' ')"
		fi
		if ! cmp -s "$TMPD/b.meta" "$TMPD/b.back"; then
			state=OFF ; note="${note:+$note; }meta and back-links name different parts: $(comm -3 "$TMPD/b.meta" "$TMPD/b.back" | tr -d "$TAB" | tr '\n' ' ')"
		fi
		inmodel=0 ; missing=
		if [ -f "$MODEL" ]; then
			while IFS= read -r p; do
				[ -n "$p" ] || continue
				if grep -Fq "$p" "$MODEL"; then inmodel=$((inmodel+1))
				else missing="${missing:+$missing }$p" ; fi
			done < "$TMPD/b.back"
			[ -n "$missing" ] && { state=OFF ; note="${note:+$note; }back-linked but not named in the model: $missing" ; }
		fi
		wrongj=
		if [ -f "$BACKL" ]; then
			wrongj=$(grep -v '^#' "$BACKL" | awk -F"$TAB" -v J="$JNAME" 'NF>1 && $2!=J {print $1}' | tr '\n' ' ')
			[ -n "$wrongj" ] && { state=OFF ; note="${note:+$note; }back-link rows naming another juncture: $wrongj" ; }
		fi

		if [ "$OPT_TSV" = 1 ]; then
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$JNAME" "$state" "$ns" "$nm" "$nb" "$inmodel" "${note:--}"
		else
			printf '%-11s %-12s spec=%s meta=%s backlinks=%s in-model=%s\n' "$state" "$JNAME" "$ns" "$nm" "$nb" "$inmodel"
			[ -n "$note" ] && printf '            %s\n' "$note"
		fi
	done
	return 0
}

cmd_ingredients() {
	: > "$TMPD/asks"
	for s in "$@"; do
		[ -f "$s" ] || continue
		n=$(f_one juncture "$s") ; [ -n "$n" ] || continue
		# field 6 is the spec's own path and field 7 its line number: the other end of the entry.
		# A register that says "raised by finding" without saying WHERE is a hint, not a pointer.
		awk -F"$TAB" -v J="$n" -v F="$s" '$1=="ask"{printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", $2, J, $3, $4, $5, F, NR}' "$s" >> "$TMPD/asks"
	done
	: > "$TMPD/ruled"
	for s in "$@"; do
		[ -f "$s" ] || continue
		n=$(f_one juncture "$s") ; [ -n "$n" ] || continue
		awk -F"$TAB" -v J="$n" -v F="$s" '$1=="ruled"{printf "%s\t%s\t%s\t%s\t%s\t%s\n", $2, J, $3, $4, $5, F"\t"NR}' "$s" >> "$TMPD/ruled"
	done
	sort -t"$TAB" -k1,1 -k2,2 "$TMPD/ruled" > "$TMPD/ruled.s"
	nruled=$(awk -F"$TAB" '{print $1}' "$TMPD/ruled.s" | sort -u | grep -c .)
	sort -t"$TAB" -k1,1 -k2,2 "$TMPD/asks" > "$TMPD/asks.s"
	awk -F"$TAB" '{print $1}' "$TMPD/asks.s" | sort -u > "$TMPD/ids"
	nid=$(grep -c . "$TMPD/ids" 2>/dev/null) ; nid=${nid:-0}
	nsp=0 ; for s in "$@"; do [ -f "$s" ] && nsp=$((nsp+1)) ; done
	nshared=$(awk -F"$TAB" '{c[$1]=c[$1] " " $2} END{for(i in c){n=split(c[i],a," "); if(n>1) k++} print k+0}' "$TMPD/asks.s")

	if [ "$OPT_TSV" = 1 ]; then
		printf 'id\tjunctures\tn_junctures\tquestion\tunblocks\tcost\tposted_at\tstate\n'
	else
		printf '# INGREDIENTS — the open questions, entered twice\n\n'
		printf '> **DERIVED — do not hand-edit.** Regenerate with\n'
		printf '> `sh bin/ju1as ingredients > q/junctures/INGREDIENTS.md`.\n'
		printf '> Questions are written in the `.juncture` specs, never here; this file is the\n'
		printf '> other end of every one of those entries.\n\n'
		printf 'An *ingredient* is a question a juncture raised and no instrument can settle — it\n'
		printf 'wants the keeper. Each one has a stable id, and **the same id names the same\n'
		printf 'question in every juncture that raises it**. That is the cross-reference: a question\n'
		printf 'is not filed under one heading, it stands at every crossing it touches, and this\n'
		printf 'register is where you can see all of them at once.\n\n'
		printf 'Counted, not guessed: **%s question(s) across %s juncture(s); %s raised at more than\n' "$nid" "$nsp" "$nshared"
		printf 'one crossing; %s answered by a ruling.**\n\n' "$nruled"
		printf -- '```sh\n'
		printf 'sh bin/ju1as ingredients --tsv | tail -n +2 | wc -l      # the question count\n'
		printf 'sh bin/ju1as ingredients --tsv | awk -F"\\t" %s$8=="CONFLICT"%s   # one id, two questions\n' "'" "'"
		printf 'sh bin/ju1as ingredients --tsv | awk -F"\\t" %s$8=="RULED"%s      # answered, and by whom\n' "'" "'"

		printf -- '```\n\n'
		printf '## The register\n\n'
		printf '| id | state | raised by | question | answering it unblocks | cost of leaving it |\n'
		printf '|---|---|---|---|---|---|\n'
	fi

	while IFS= read -r id; do
		[ -n "$id" ] || continue
		js=$(awk -F"$TAB" -v I="$id" '$1==I{print $2}' "$TMPD/asks.s" | sort -u | tr '\n' ' ' | sed 's/ $//')
		nj=$(awk -F"$TAB" -v I="$id" '$1==I{print $2}' "$TMPD/asks.s" | sort -u | grep -c .)
		q=$(awk -F"$TAB" -v I="$id" '$1==I{print $3; exit}' "$TMPD/asks.s")
		u=$(awk -F"$TAB" -v I="$id" '$1==I{print $4; exit}' "$TMPD/asks.s")
		c=$(awk -F"$TAB" -v I="$id" '$1==I{print $5; exit}' "$TMPD/asks.s")
		posted=$(awk -F"$TAB" -v I="$id" '$1==I{printf "%s:%s ", $6, $7}' "$TMPD/asks.s" | sed 's/ $//')
		nq=$(awk -F"$TAB" -v I="$id" '$1==I{print $3}' "$TMPD/asks.s" | sort -u | grep -c .)
		nr=$(awk -F"$TAB" -v I="$id" '$1==I' "$TMPD/ruled.s" | grep -c .)
		st=OPEN ; [ "$nr" -gt 0 ] && st=RULED
		# CONFLICT outranks RULED: an id that means two questions is the worse fault, and a
		# ruling posted against a drifting id answers whichever question you happened to read.
		[ "$nq" -gt 1 ] && st=CONFLICT
		if [ "$OPT_TSV" = 1 ]; then
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$js" "$nj" "$q" "$u" "$c" "$posted" "$st"
		else
			mark= ; [ "$st" = CONFLICT ] && mark=' **CONFLICT: one id, more than one question**'
			printf '| **%s** | %s | %s | %s%s | %s | %s |\n' \
				"$id" "$st" "$(md_cell "$(printf '%s' "$js" | sed 's/ / · /g')")" "$(md_cell "$q")" "$mark" "$(md_cell "$u")" "$(md_cell "$c")"
		fi
	done < "$TMPD/ids"

	[ "$OPT_TSV" = 1 ] && return 0

	printf '\n## Each one, with both ends of its entry\n\n'
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		q=$(awk -F"$TAB" -v I="$id" '$1==I{print $3; exit}' "$TMPD/asks.s")
		u=$(awk -F"$TAB" -v I="$id" '$1==I{print $4; exit}' "$TMPD/asks.s")
		c=$(awk -F"$TAB" -v I="$id" '$1==I{print $5; exit}' "$TMPD/asks.s")
		printf '### %s\n\n' "$id"
		printf '**Question.** %s\n\n' "$q"
		printf '**Answering it unblocks.** %s\n\n' "$u"
		printf '**Cost of leaving it.** %s\n\n' "$c"
		printf '**Raised at, and where the entry is written:**\n\n'
		awk -F"$TAB" -v I="$id" '$1==I{printf "- `%s` — `%s:%s`\n", $2, $6, $7}' "$TMPD/asks.s"
		printf '\n'
		if awk -F"$TAB" -v I="$id" '$1==I' "$TMPD/ruled.s" | grep -q .; then
			printf '**RULED.** The question stays above; this is the answer, and it was written\n'
			printf 'into the spec, not here.\n\n'
			awk -F"$TAB" -v I="$id" '$1==I{printf "- %s\n  — *%s, %s* · `%s`, raised by `%s`, ruling at `%s:%s`\n", $3, $4, $5, $6, $2, $6, $7}' "$TMPD/ruled.s"
			printf '\n'
		fi
	done < "$TMPD/ids"

	printf '## What this register refuses\n\n'
	printf -- '- **It refuses to be the place a question is written.** A question lives in the spec of\n'
	printf '  the juncture that raised it. If it were typed here it would have one end only, and a\n'
	printf '  half-entry is the failure this whole room exists to make impossible.\n'
	printf -- '- **It refuses to let one id mean two questions.** `--tsv` carries a `state` column and\n'
	printf '  it reads `CONFLICT` when two specs disagree about what an id asks. An id that drifts is\n'
	printf '  worse than no id, because the cross-reference still looks like it resolves.\n'
	printf -- '- **It refuses to answer anything.** Every question here is for the keeper. An instrument\n'
	printf '  that answered one would be guessing in a format that looks like a ruling. A `ruled` row\n'
	printf '  is not this program answering: it is the keeper'"'"'s sentence, carried with the name of\n'
	printf '  whoever ruled and the date, written into the spec at the crossing that raised the\n'
	printf '  question and read back out here. The question is never deleted when it is answered --\n'
	printf '  both ends stay, so a reader sees what was asked as well as what was decided.\n\n'
	printf '**Falsifier for this file:** `sh bin/ju1as ingredients` and `diff` against it. Any\n'
	printf 'difference means someone edited the register instead of the spec, and the entry that\n'
	printf 'differs is the one that now exists at one end only.\n'
	return 0
}

# ---- --prove-red ------------------------------------------------------------------------------------
# The claims: it assembles when a part moved, it does NOT when nothing moved, the back-links are the
# other end of the same links, a spec cannot execute, and a spec cannot name a path outside its root.
cmd_red() {
	d="$TMPD/red" ; mkdir -p "$d/forest/bin" "$d/forest/q/junctures" || die "cannot make fixture"
	cp "$0" "$d/forest/bin/ju1as" 2>/dev/null || die "cannot stage the assembler"
	cp "$AT1PL" "$d/forest/bin/at1pl" 2>/dev/null || die "cannot stage at1pl"
	chmod +x "$d/forest/bin/ju1as" "$d/forest/bin/at1pl" 2>/dev/null || :
	printf 'a part that will move\n'   > "$d/forest/moves.txt"
	printf 'a part that will not\n'    > "$d/forest/steady.txt"
	J="$d/forest/q/junctures/fixture.juncture"
	{
	printf 'juncture=fixture\n'
	printf 'title=a fixture crossing\n'
	printf 'root=c4\n'
	printf 'say=Planted on purpose.\n'
	printf 'falsifier=Delete moves.txt and this juncture must report it GONE.\n'
	printf 'part\tmoves.txt\tatom\tthe one that advances\n'
	printf 'part\tsteady.txt\tcontrol\tthe one that must stay OK\n'
	printf 'ask\tING-9999\tis this fixture a juncture\tnothing\tnothing\n'
	printf 'ask\tING-9998\tis a ruling carried without deleting its question\tnothing\tnothing\n'
	printf 'ruled\tING-9998\tyes -- both ends stay\ta fixture keeper\t2026-09-17\n'
	} > "$J"
	find "$d/forest" -exec touch -t 202601010000 {} + 2>/dev/null || :

	fail=0
	want() { case "$2" in *"$1"*) printf 'prove-red  RED  %s\n' "$3" ;;
		*) printf 'prove-red  FAIL %s\n' "$3" >&2 ; fail=$((fail+1)) ;; esac ; }
	deny() { case "$2" in *"$1"*) printf 'prove-red  FAIL %s\n' "$3" >&2 ; fail=$((fail+1)) ;;
		*) printf 'prove-red  RED  %s\n' "$3" ;; esac ; }

	o1=$(sh "$d/forest/bin/ju1as" assemble "$J" 2>&1) ; r1=$?
	want 'ASSEMBLED' "$o1" 'a juncture with no meta assembles, and says so'
	[ "$r1" = 0 ] || { printf 'prove-red  FAIL exit %s on a first assembly\n' "$r1" >&2 ; fail=$((fail+1)) ; }

	o2=$(sh "$d/forest/bin/ju1as" assemble "$J" 2>&1)
	want 'CACHED' "$o2" 'nothing moved, so the cached assembly stands -- the cheap case'
	deny 'ASSEMBLED' "$o2" 'a quiet forest does not reassemble; this tool does not cry wolf'

	printf 'it moved\n' > "$d/forest/moves.txt" ; touch "$d/forest/moves.txt" 2>/dev/null || :
	o3=$(sh "$d/forest/bin/ju1as" assemble "$J" 2>&1)
	want 'ASSEMBLED' "$o3" 'one part advanced, so it reassembled'
	want 'moves.txt' "$o3" 'and the reason names the atom that moved'

	o4=$(sh "$d/forest/bin/ju1as" balance "$J" 2>&1)
	want 'BALANCED' "$o4" 'spec, meta and back-links agree row for row'

	b="$d/forest/q/junctures/fixture.backlinks.tsv"
	grep -v '^steady.txt' "$b" > "$b.tmp" && mv "$b.tmp" "$b"
	o5=$(sh "$d/forest/bin/ju1as" balance "$J" 2>&1)
	want 'OFF' "$o5" 'remove one back-link row and the trial balance goes OFF'
	want 'steady.txt' "$o5" 'and it names the link that lost its other end'

	rm -f /tmp/ju1as-pwned
	P="$d/forest/q/junctures/pwn.juncture"
	{
	printf 'juncture=pwn\n'
	printf 'title=$(touch /tmp/ju1as-pwned)\n'
	printf 'root=c4\n'
	printf 'say=`touch /tmp/ju1as-pwned`\n'
	printf 'part\tsteady.txt\t$(touch /tmp/ju1as-pwned)\tnote\n'
	} > "$P"
	sh "$d/forest/bin/ju1as" assemble "$P" >/dev/null 2>&1
	if [ -f /tmp/ju1as-pwned ]; then
		printf 'prove-red  FAIL the spec ran. A spec that can run is not data.\n' >&2 ; fail=$((fail+1))
		rm -f /tmp/ju1as-pwned
	else
		printf 'prove-red  RED  a spec is data: nothing in it executed\n'
	fi

	E="$d/forest/q/junctures/escape.juncture"
	{
	printf 'juncture=escape\n'
	printf 'title=a spec that reaches out of its root\n'
	printf 'root=c4\n'
	printf 'part\t../../etc/passwd\tatom\tclimbing\n'
	printf 'part\t/etc/passwd\tatom\tabsolute\n'
	printf 'part\tsteady.txt\tcontrol\tthe legal one\n'
	} > "$E"
	o6=$(sh "$d/forest/bin/ju1as" assemble "$E" 2>&1)
	want 'REFUSED' "$o6" 'a part path that is absolute or climbs is refused, and named'
	deny 'passwd' "$(cat "$d/forest/q/junctures/escape.backlinks.tsv" 2>/dev/null)" 'and neither refused path reached the back-links'

	o7=$(sh "$d/forest/bin/ju1as" ingredients "$J" 2>&1)
	want 'ING-9999' "$o7" 'the ingredient register carries the question by id'
	want 'RULED' "$o7" 'an answered question is marked RULED rather than removed'
	want 'both ends stay' "$o7" 'and the ruling itself is carried, attributed and dated'
	want 'is a ruling carried without deleting its question' "$o7" 'and the question it answers is still there'
	o8=$(sh "$d/forest/bin/ju1as" ingredients "$J" --tsv 2>&1)
	want 'RULED' "$o8" 'the tsv state column says RULED so a reader can count answers'

	rm -f "$d/forest/moves.txt"
	o8=$(sh "$d/forest/bin/ju1as" check "$J" 2>&1) ; r8=$?
	want 'MOVED' "$o8" 'a part that vanished is reported, not silently held'
	[ "$r8" = 0 ] || { printf 'prove-red  FAIL check exited %s on a stale juncture; it must exit 0\n' "$r8" >&2 ; fail=$((fail+1)) ; }

	printf '\n'
	if [ "$fail" = 0 ]; then
		printf 'prove-red PASS: it assembles when a part moved, holds when none did, posts both ends\n'
		printf 'of every link, goes OFF when one end is removed, refuses a path outside its root, and\n'
		printf 'a spec full of shell never ran.\n'
		return 0
	fi
	printf 'prove-red FAILED: %s planted fault(s) went unnoticed. Do not trust this assembler.\n' "$fail" >&2
	return 1
}

# ---- argv ------------------------------------------------------------------------------------------
AT1PL=$(find_at1pl) || die "cannot find at1pl; it is the freshness primitive and this program will not guess without it"

cmd=${1:-} ; [ $# -gt 0 ] && shift
case "$cmd" in
	-h|--help|"") sed -n '2,72p' "$0" ; exit 0 ;;
	--prove-red) cmd_red ; exit $? ;;
	assemble|check|balance|ingredients) : ;;
	*) die "unknown command '$cmd'; try assemble, check, balance, ingredients, --prove-red, -h" ;;
esac

specs=
while [ $# -gt 0 ]; do
	case "$1" in
		-r) [ $# -ge 2 ] || die "-r needs a ROOT" ; OPT_ROOT=$2 ; shift 2 ;;
		-o) [ $# -ge 2 ] || die "-o needs a DIR" ; OPT_OUT=$2 ; shift 2 ;;
		--tsv) OPT_TSV=1 ; shift ;;
		--force) OPT_FORCE=1 ; shift ;;
		--) shift ; break ;;
		-*) die "$cmd: unknown option $1" ;;
		*) specs="${specs:+$specs }$1" ; shift ;;
	esac
done
for a in "$@"; do specs="${specs:+$specs }$a"; done

if [ -z "$specs" ]; then
	specs=$(default_specs | tr '\n' ' ')
	[ -n "$specs" ] || die "no SPEC given and no *.juncture found in $(c4root)/q/junctures"
fi

# shellcheck disable=SC2086
case "$cmd" in
	assemble)    cmd_assemble    $specs ;;
	check)       cmd_check       $specs ;;
	balance)     cmd_balance     $specs ;;
	ingredients) cmd_ingredients $specs ;;
esac
exit 0
