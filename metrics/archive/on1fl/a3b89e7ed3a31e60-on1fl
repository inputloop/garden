#!/bin/sh
# c4/bin/on1fl -- ONE FILE.  Wrap a payload into a single self-contained HTML page
# that explains itself, carries the payload, computes its OWN hash from the bytes
# it is holding, and can be made to fail on command.
#
# PROVENANCE.  The emitter below is Bryant's, shipped inline inside the `primer`
# skill (from-bryant/2026-09-17/primer.skill) expressly to be written out rather
# than pointed at.  NAMED, NEVER VENDORED runs both ways: this file says whose it
# is, and where this shop and that skill disagree, this shop's canon wins.
# Blessed in 2026-09-17 after it passed its own gate here -- see --prove-red, and
# the three-witness receipt in facts/a-page-that-hashes-itself-needs-three-witnesses.
#
# WHAT THIS SHOP ADDED: --prove-red (eight checks, four of them planted faults)
# and --witness (an independent third hasher when one is on the machine).
# The emitter itself is unchanged; that is deliberate, so the two gardens can
# diff it byte for byte.
#
# TWO DECLARATIONS, because an undeclared check reads as MUST:
#
#   MUST     the payload's sha256; that the base64 the page carries decodes back to those same
#            bytes; the declared byte count against the real one; the number of `https?://`
#            references in the emitted page; the refusal when the payload is not there; and under
#            --witness, the three readings side by side, plus WITNESS ABSENT when no JS engine is
#            on the machine.  All computed from the bytes; none of it taken on anyone's word.
#
#   JOURNEY  THE THREE PROPERTIES ARE A STANDARD, NOT A MEASUREMENT.  That a hand-back must
#            UNPACK, PROVE and FAIL ON COMMAND -- and that all three are required or there is a
#            hole -- is the gate this shop blessed in on 2026-09-17.  A destination could be well
#            served by a form holding two of them; nothing here weighs that.
#            WHAT THE DESTINATION HAS IS ASSUMED, NEVER ASKED.  "Only what the far machine already
#            has" is read here as A BROWSER OPENING A file:// URL.  That assumption is the whole
#            of UNPACKS and it is never checked against an actual destination.  For GIZA it holds;
#            name the destination before carrying the assumption anywhere else.
#            ZERO `https?://` IS A PROXY FOR SELF-CONTAINED.  A page could reach the network by
#            other spellings and this grep would not see it.
#            ONE FLIPPED BYTE IN THE FIRST POSITION is this tool's demonstration that the check
#            can fail -- sufficient to show red, not exhaustive.
#            THE PAGE'S BEHAVIOUR IN A BROWSER IS NOT OBSERVED HERE.  --prove-red checks bytes and
#            claim with shell tools; the green-then-red the READER will see is the emitted
#            script's, and it is exercised only when --witness finds a JS engine.  THREE witnesses
#            is a number this shop chose, not one anything derived.
#            THE EMITTER IS BRYANT'S, kept unchanged on purpose so the two gardens can diff it
#            byte for byte.  That this shop's canon wins where his skill and this shop differ is a
#            governance call, not a computation.
#
# Depends on: sh, base64, sha256sum or shasum, sed, wc.  Nothing else.
set -eu

emit() {
# onefile.sh - wrap a payload into ONE self-contained HTML page that explains it,
# carries it, proves itself, and fails on command.
F=${1:?usage: onefile.sh PAYLOAD [TITLE] [WHAT]}
T=${2:-$(basename "$F")}
W=${3:-"A single-file deliverable."}
[ -f "$F" ] || { echo "no such file: $F" >&2; exit 2; }
if command -v sha256sum >/dev/null 2>&1; then SUM=$(sha256sum "$F" | cut -d' ' -f1)
else SUM=$(shasum -a 256 "$F" | cut -d' ' -f1); fi
B64=$(base64 "$F" | tr -d '\n')
SIZE=$(wc -c < "$F" | tr -d ' ')
NAME=$(basename "$F")
esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
cat <<HTML
