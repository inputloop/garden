}

hash_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

usage() {
  cat <<'USAGE'
usage:
  on1fl PAYLOAD [TITLE] [WHAT] > deliver.html   emit the one-file page
  on1fl --prove-red                             plant every fault; show them all red
  on1fl --witness PAGE PAYLOAD                  third hasher, if one is on the machine
  on1fl -h                                      this header

THE THREE PROPERTIES, and the third is the one people leave out:
  UNPACKS   needs only what the far machine already has -- here, a browser, from file://
  PROVES    the page computes the hash itself, from the bytes it carries, not from a README
  FAILS ON COMMAND  a button flips a byte so the reader WATCHES it go red before trusting green

A green light nobody has ever seen turn red is not evidence, it is decoration.
So this program refuses to claim green without having shown you red: --prove-red
plants four faults and requires every one of them to fire.
USAGE
}

# ---------------------------------------------------------------- --prove-red
chk() { # chk NAME WANT GOT
  if [ "$2" = "$3" ]; then printf '  ok    %s\n' "$1"
  else printf '  FAIL  %s\n        want %s\n        got  %s\n' "$1" "$2" "$3"; fails=$((fails+1)); fi
}

prove_red() {
  d=$(mktemp -d) || exit 1
  trap 'rm -rf "$d"' EXIT INT TERM
  fails=0
  printf 'the index can be wrong and say so\n' > "$d/p"
  emit "$d/p" "self test" "a planted payload" > "$d/page.html"
  claim=$(sed -n 's/.*id="claim">\([0-9a-f]*\).*/\1/p' "$d/page.html")
  b64=$(sed -n 's/^var B64="\([^"]*\)".*/\1/p' "$d/page.html")
  size=$(sed -n 's,.*<dt>bytes</dt><dd>\([0-9]*\)</dd>.*,\1,p' "$d/page.html")

  echo "GREEN -- what must hold:"
  chk "claim agrees with an independent sha256"      "$(hash_of "$d/p")" "$claim"
  chk "page carries zero external references"        "0" "$(grep -c 'https\?://' "$d/page.html" || true)"
  chk "carried base64 decodes back to the payload"   "$(hash_of "$d/p")" "$(printf '%s' "$b64" | base64 -d > "$d/back" && hash_of "$d/back")"
  chk "declared byte count is the real byte count"   "$(wc -c < "$d/p" | tr -d ' ')" "$size"

  echo "RED -- four planted faults, every one must fire:"
  printf 'x' >> "$d/p"                               # fault 1: the payload moved
  if [ "$claim" != "$(hash_of "$d/p")" ]; then echo "  ok    a changed payload no longer matches the claim"
  else echo "  FAIL  a changed payload still matched the claim"; fails=$((fails+1)); fi

  sed 's,</head>,<script src="https://cdn.example/x.js"></script></head>,' "$d/page.html" > "$d/cdn.html"
  if [ "$(grep -c 'https\?://' "$d/cdn.html" || true)" != "0" ]; then echo "  ok    an injected CDN reference is seen"
  else echo "  FAIL  an injected CDN reference was not seen"; fails=$((fails+1)); fi

  bad=$(printf '%s' "$b64" | sed 's/^./Z/')          # fault 3: the carried bytes moved
  printf '%s' "$bad" | base64 -d > "$d/bad" 2>/dev/null || true
  if [ "$claim" != "$(hash_of "$d/bad" 2>/dev/null || echo none)" ]; then echo "  ok    corrupted carried bytes no longer match the claim"
  else echo "  FAIL  corrupted carried bytes still matched the claim"; fails=$((fails+1)); fi

  if ( emit "$d/nope" x y >/dev/null 2>&1 ); then     # fault 4: a payload that is not there
    echo "  FAIL  a missing payload was accepted"; fails=$((fails+1))
  else echo "  ok    a missing payload is refused, not papered over"; fi

  echo
  if [ "$fails" -eq 0 ]; then echo "on1fl: 8/8 -- four held, four fired."; else echo "on1fl: $fails FAILED"; fi
  [ "$fails" -eq 0 ]
}

# ------------------------------------------------------------------ --witness
# A page that hashes itself with its own JavaScript is ONE witness.  sha256sum is
# a second.  This runs the page's OWN script under a JS engine when the machine
# has one -- a third reading, from the same bytes, by a different implementation.
# ABSENT is a real answer here and is reported as ABSENT, never as agreement.
witness() {
  page=${1:?usage: on1fl --witness PAGE PAYLOAD}; pay=${2:?}
  js=$(command -v node || command -v nodejs || true)
  if [ -z "$js" ]; then echo "WITNESS ABSENT -- no JS engine on this machine; two readings, not three."; return 0; fi
  w=$(mktemp -d); trap 'rm -rf "$w"' EXIT INT TERM
  { echo 'var atob=function(s){return Buffer.from(s,"base64").toString("binary")};'
    sed -n '/^var B64=/,/^function check()/p' "$page" | sed '$d'
    echo 'var g=sha256(ORIG), b=ORIG.slice(0); b[0]=b[0]^1;'
    echo 'console.log(g); console.log(sha256(b)); console.log(CLAIM);'
  } > "$w/run.js"
  out=$("$js" "$w/run.js" 2>/dev/null) || {
    echo "WITNESS ABSENT -- the page's script would not run standalone here."; return 0; }
  green=$(echo "$out" | sed -n 1p); red=$(echo "$out" | sed -n 2p); said=$(echo "$out" | sed -n 3p)
  third=$(hash_of "$pay")
  printf '  page JS, carried bytes : %s\n  page claim             : %s\n  %-22s : %s\n' "$green" "$said" "$(basename "${js}") vs sha256sum" "$third"
  printf '  after one flipped byte : %s...\n' "$(echo "$red" | cut -c1-16)"
  if [ "$green" = "$said" ] && [ "$green" = "$third" ] && [ "$red" != "$said" ]; then
    echo "WITNESS AGREE -- three readings of the same bytes, and it still goes red on command."
  else
    echo "WITNESS DISAGREE -- do not carry this page."; return 1
  fi
}

case "${1:-}" in
  -h|--help|"") usage; exit 0 ;;
  --prove-red)  prove_red; exit $? ;;
  --witness)    shift; witness "$@"; exit $? ;;
esac
emit "$@"
