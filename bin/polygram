# polygram — POSIX shell entry point.
# Delegates to the python package, locating the repo root from this script's
# own path so it works regardless of the caller's cwd. Honors $PYTHON.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)

PYTHON=${PYTHON:-python3}
command -v "$PYTHON" >/dev/null 2>&1 || PYTHON=python

exec env PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON" -m polygram "$@"
