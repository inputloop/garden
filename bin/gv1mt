    # ------------------------------------------------ build
    def build(self):
        self.pending_his, self.ours_text, self.notices = [], {}, {}
        self.read_bryant()
        self.read_ours()
        self.read_servers()
        self.read_ledger()
        self.resolve_pending()
        self.counterparts()
        self.our_text_edges()
        self.read_tensions()
        self.read_compass()
        self.read_doorways()
        fams = [{"id": "ours", "name": "Our skills", "slot": None, "blurb": "skills/ in the garden", "garden": "corwin"},
                {"id": "soft", "name": "Our soft skills", "slot": None, "blurb": "SOFT-SKILLS/, served live",
                 "garden": "corwin"},
                {"id": "server", "name": "The plugin's servers", "slot": None, "blurb": "dist/vibrobeast/.mcp.json",
                 "garden": "corwin"},
                {"id": "persona", "name": "Personas", "slot": None, "blurb": "the persona ledger's sheets",
                 "garden": "corwin"},
                {"id": "external", "name": "Named, not here", "slot": None, "blurb": "platform, Anthropic, or kept elsewhere",
                 "garden": "platform"}]
        self.families += fams
        nodes = sorted(self.nodes.values(), key=lambda n: n["id"])
        edges = sorted(self.edges.values(), key=lambda e: (e[2], e[0], e[1]))
        counts = {"sources": len(self.src.rows), "missing": sum(1 for s in self.src.rows if s.get("missing")),
                  "nodes": len(nodes), "edges": len(edges), "tensions": len(self.tensions),
                  "open": sum(1 for x in self.tensions if x["state"] == "open"),
                  "resolved": sum(1 for x in self.tensions if x["state"] == "resolved"), "people": self.people}
        for k in KINDS:
            counts["kind." + k] = sum(1 for n in nodes if n["kind"] == k)
        for t in EDGE_TYPES:
            counts["type." + t] = sum(1 for e in edges if e[2] == t)
        data = {
            "format": FORMAT, "built": self.built, "builder": "bin/gv1mt " + VERSION,
            "sources": self.src.rows,
            "gardens": [
                {"id": "corwin", "name": "Corwin's garden", "keeper": "Corwin Brust", "with": "Mentat (for Corwin; claude-opus-5-5)"},
                {"id": "bryant", "name": "Bryant's garden", "keeper": "Bryant Frankford", "with": "Alfred (for Bryant; claude-opus-5-5)"}],
            "families": self.families, "nodes": nodes, "edges": edges, "tensions": self.tensions,
            "compass": self.compass, "doorways": self.doorways,
            "terms": {"code": "GPL-3.0-or-later OR LGPL-3.0-or-later", "prose": "CC-BY-SA-4.0",
                      "holders": ["Corwin Brust", "Bryant Frankford"], "and": "Contributors",
                      "his_words": (self.bryant_nexus or {}).get("terms", {}) and (self.bryant_nexus["terms"] or {}).get("quote")},
            "starting_point": {"skill_tree": self.bryant_tree, "nexus_map": {k: v for k, v in (self.bryant_nexus or {}).items() if k != "terms"} or None},
            "counts": counts}
        data["seal"] = {"sha256": seal(data)}
        return data


# ---------------------------------------------------------------- the copy for sharing (--public)
RE_CLAUDE = re.compile(r"(?:https?://)?claude\.ai/[^\s\])>\"`'|]*")
RE_DRIVE = re.compile(r"(?<![A-Za-z0-9_<])([A-Za-z]):((?:[\\/]+[^\s\"'<>|*?`)\],;]*)+)")
RE_MSYS = re.compile(r"(^|[\s`'\"(=])/([a-z])/(?=[A-Za-z0-9_.-])")
RE_UNC = re.compile(r"\\{2,}[A-Za-z0-9_.-]+\\+")


def mask_text(s, tally):
    """This machine's paths and claude.ai links in S, masked; nothing else changes, nothing is dropped.
    A drive letter D: becomes <D>: (its backslashes written as /, so an escaped copy cannot read as a UNC
    path); an msys /d/ becomes <D>:/; a UNC host becomes <UNC>/; a claude.ai link becomes <claude.ai link>."""
    def claude(m):
        tally["claude-ai-link"] += 1
        return "<claude.ai link>"

    def drive(m):
        tally["drive-letter"] += 1
        return "<%s>:%s" % (m.group(1).upper(), re.sub(r"[\\/]+", "/", m.group(2)))

    def msys(m):
        tally["msys-path"] += 1
        return "%s<%s>:/" % (m.group(1), m.group(2).upper())

    def unc(m):
        tally["unc-path"] += 1
        return "<UNC>/"
    s = RE_CLAUDE.sub(claude, s)
    s = RE_DRIVE.sub(drive, s)
    s = RE_MSYS.sub(msys, s)
    s = RE_UNC.sub(unc, s)
    return s


def masked(obj, tally):
    if isinstance(obj, str):
        return mask_text(obj, tally)
    if isinstance(obj, list):
        return [masked(x, tally) for x in obj]
    if isinstance(obj, dict):
        return {k: masked(v, tally) for k, v in obj.items()}
    return obj


def public_copy(data):
    tally = {"drive-letter": 0, "msys-path": 0, "unc-path": 0, "claude-ai-link": 0}
    d = masked({k: v for k, v in data.items() if k != "seal"}, tally)
    d["masked"] = tally
    d["seal"] = {"sha256": seal(d)}
    return d


def canon(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", ":"))


def seal(data):
    d = {k: v for k, v in data.items() if k != "seal"}
    return hashlib.sha256(canon(d).encode("utf-8")).hexdigest()


# ---------------------------------------------------------------- facts and words
def fv(s):
    return re.sub(r"\s", "%20", str(s if s is not None else "-")) or "-"


def facts(data):
    out = []
    for s in data["sources"]:
        out.append("SOURCE path=%s reader=%s state=%s" % (fv(s["path"]), fv(s["reader"]),
                                                          "missing" if s.get("missing") else "read"))
    for n in data["nodes"]:
        out.append("NODE id=%s kind=%s garden=%s state=%s" % (fv(n["id"]), n["kind"], n["garden"], fv(n.get("state"))))
    for e in data["edges"]:
        out.append("EDGE from=%s to=%s type=%s state=%s" % (fv(e[0]), fv(e[1]), e[2], fv(e[4].get("state"))))
    for x in data["tensions"]:
        out.append("TENSION id=%s state=%s rule=%s" % (fv(x["id"]), x["state"], fv(x.get("rule"))))
    head = "FACTS v=1 format=%s built=%s" % (fv(data["format"]), fv(data["built"]))
    os.environ["LC_ALL"] = "C"
    return head + "\n" + "\n".join(sorted(out, key=lambda s: s.encode("utf-8"))) + "\n"


def words(data):
    c = data["counts"]
    sp = data.get("starting_point") or {}
    lines = [
        "The garden view, built %s from %d sources (%d missing)." % (data["built"], c["sources"], c["missing"]),
        "%d things are drawn: %d skills, %d soft skills, %d servers, %d personas and %d named from elsewhere; "
        "%d person models are counted and never drawn." % (c["nodes"], c["kind.skill"], c["kind.soft"], c["kind.server"],
                                                           c["kind.persona"], c["kind.external"], c["people"]),
        "%d links: %s." % (c["edges"], ", ".join("%d %s" % (c["type." + t], t) for t in EDGE_TYPES if c["type." + t])),
        "%d tensions: %d open and %d resolved." % (c["tensions"], c["open"], c["resolved"]),
        "Starting point: Bryant Frankford's Nexus Skill Tree (%s) and his Gauntlet Nexus Map (%s)." % (
            ((sp.get("skill_tree") or {}).get("file") or "not found"), ((sp.get("nexus_map") or {}).get("file") or "not found"))]
    for s in data["sources"]:
        if s.get("missing"):
            lines.append("MISSING: %s (%s) could not be read; the view is built without it." % (s["path"], s["reader"]))
    return "\n".join(lines) + "\n"


