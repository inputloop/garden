def page(data):
    c = data["counts"]
    t_open = [x for x in data["tensions"] if x["state"] == "open"]
    sp = data.get("starting_point") or {}
    tree = sp.get("skill_tree") or {}
    nex = sp.get("nexus_map") or {}
    edgecss = "\n".join("#ring .e-%s{stroke:var(--e-%s)%s}" % (k, k, (";stroke-dasharray:" + DASH[k]) if DASH[k] else "")
                        for k in EDGE_TYPES)
    css = CSS % {"light": tokens_css(LIGHT), "dark": tokens_css(DARK), "edgecss": edgecss}
    rb = words(data).strip().splitlines()
    P = []
    a = P.append
    a('<!doctype html><html lang="en"><head><meta charset="utf-8">')
    a('<meta name="viewport" content="width=device-width,initial-scale=1">')
    a('<title>Garden View</title>')
    a('<meta name="description" content="Bryant\'s garden and ours, drawn side by side with the tensions between them, '
      'rebuilt at every build.">')
    a('<meta name="generator" content="%s">' % esc(data["builder"]))
    a("<style>%s</style></head><body>" % css)
    a('<a href="#main" class="muted">Skip to the view</a>')
    a('<header><div class="bar"><h1>Garden View</h1><button id="theme" type="button" hidden>Theme: follows the system</button></div>')
    a('<p class="muted">Built %s by <code>bin/gv1mt</code> from the files as they were then. Seal: <code>%s</code> '
      '(<span id="seal-state">checked when JavaScript runs</span>).</p></header>' % (esc(data["built"]), esc(data["seal"]["sha256"][:16])))
    a('<main id="main">')
    a('<section aria-labelledby="h-read"><h2 id="h-read">In words</h2><div class="readback">%s</div>'
      % "".join("<p>%s</p>" % esc(s) for s in rb))
    a('<p>This view starts from Bryant Frankford\'s <strong>Nexus Skill Tree</strong> (built %s by Alfred for Bryant), '
      'the drawing of his garden\'s skills and the lines between them, and from his <strong>Gauntlet Nexus Map</strong> '
      '(%s). I redrew his ring from his own data, then set ours beside it so the two can be read together.</p>'
      % (esc(tree.get("built") or "2026-09-17"), esc(nex.get("date") or "not found")))
    a('<blockquote><p>&ldquo;the new view that shows the resolved and opened tensions across our garden of tools '
      'and computer friends&rdquo;</p><footer>Corwin, asking for this page</footer></blockquote></section>')
    # the ring
    a('<section aria-labelledby="h-ring"><h2 id="h-ring">Two gardens, one ring</h2>')
    a('<p>Each dot is a skill, a soft skill (square), a server (diamond), a persona (triangle) or something named '
      'from elsewhere (hollow). Bryant\'s garden is on the left, ours on the right; the inner band carries the '
      'tensions, each with its word: <span class="state-open">&#9671; open</span> or '
      '<span class="state-resolved">&#9679; resolved</span>. Proposed links are dashed and say so in the story.</p>')
    a('<ul class="legend" aria-label="Kinds of line">')
    for k in EDGE_TYPES:
        a('<li><svg viewBox="0 0 34 10" aria-hidden="true"><line x1="0" y1="5" x2="34" y2="5" style="stroke:var(--e-%s);'
          'stroke-width:2.5%s"/></svg><span>%s: %d%s</span></li>'
          % (k, (";stroke-dasharray:" + DASH[k]) if DASH[k] else "", esc(EDGE_WORDS[k]), c["type." + k],
             "" if k in SHOWN else " (hidden at first)"))
    a("</ul>")
    a('<fieldset data-js hidden><legend>Show these lines</legend><div class="bar">')
    for k in EDGE_TYPES:
        a('<label><input type="checkbox" data-etype="%s"%s> %s</label>' % (k, " checked" if k in SHOWN else "", esc(k)))
    a("</div></fieldset>")
    a('<p data-nojs class="muted">Without JavaScript the hidden kinds stay hidden in the drawing; every line is still '
      'listed in the story below.</p>')
    a('<figure style="margin:0">%s<figcaption class="muted">Open an entry in the story below to light up its '
      'lines.</figcaption></figure></section>' % ring_svg(data))
    # compass beside
    cp = data["compass"]
    a('<section aria-labelledby="h-cmp"><h2 id="h-cmp">The compass</h2><p>West to east: accessibility to interoperability. South to north: convention and '
      'signage to imagination and own-ness. Every placement is a guess, with how likely I think it is (L) and how '
      'sure I am of that (C). Circles are ours, squares Bryant\'s; each number is a row of the table.</p><div class="figs"><div>%s</div><div>' % compass_svg(data))
    a('<table><caption class="muted">The compass in words (from %s)</caption><thead><tr><th>#</th><th>tool</th>'
      '<th>garden</th><th>x</th><th>y</th><th>L / C</th></tr></thead><tbody>' % esc(cp.get("source") or "no study found"))
    for i, p in enumerate(cp["points"], 1):
        a("<tr><td>%d</td><td>%s</td><td>%s</td><td>%d</td><td>%d</td><td>%.1f / %s</td></tr>"
          % (i, esc(p["label"]), "ours" if p["garden"] == "corwin" else "Bryant's", p["x"], p["y"], p["L"], esc(p["C"])))
    a("</tbody></table></div></div></section>")
    # doorways
    a('<section aria-labelledby="h-doors"><h2 id="h-doors">Doorways</h2><p>What each surface was when this page was '
      'built, and what you can ask Claude to do with it. A page cannot start a server or send on the Wire, so each '
      'action is a prompt to copy. A check of a local server runs only when you press its button.</p><div class="doors">')
    for d in data["doorways"]:
        a('<article class="door" aria-labelledby="door-%s"><h3 id="door-%s">%s</h3>' % (d["id"], d["id"], esc(d["name"])))
        a('<p><span class="badge">as built</span> %s</p>' % esc(d["status_text"]))
        a("<ul>%s</ul>" % "".join("<li class=\"wrap\">%s</li>" % esc(f) for f in d["facts"]))
        if d.get("probe"):
            for p in d["probe"]:
                pid = "probe-%s" % p["id"]
                a('<p>%s: <span class="badge" id="%s" role="status">as built (not asked yet)</span> '
                  '<button type="button" data-js hidden data-probe="%s" data-url="%s"%s>Check %s now</button></p>'
                  % (esc(p["name"]), pid, pid, esc(p["url"]),
                     (' data-same-origin="%s"' % esc(p["same_origin"])) if p.get("same_origin") else "", esc(p["name"])))
        else:
            a('<p><span class="badge unreach">not reachable from a page</span> %s</p>' % esc(d["probe_why"]))
        for i, act in enumerate(d["actions"]):
            aid = "ask-%s-%d" % (d["id"], i)
            a('<h4 style="margin:.6em 0 .1em">%s</h4><pre class="prompt" id="%s">%s</pre>'
              '<button type="button" data-js hidden data-copy="%s">Ask Claude: copy this prompt</button>'
              '<span role="status" class="muted"></span><p class="muted" style="margin:.2em 0">You should see: %s</p>'
              % (esc(act["label"]), aid, esc(act["prompt"]), aid, esc(act["see"])))
        a("</article>")
    a("</div></section>")
    # tensions
    a('<section aria-labelledby="h-t"><h2 id="h-t">Tensions, open and resolved</h2><p>%d tensions: %d open, %d resolved. '
      'An option card is resolved when its default ships in this edition; every ERRATA entry is open, because that '
      'file keeps only what is still owed.</p>' % (c["tensions"], c["open"], c["resolved"]))
    a('<table class="tt"><thead><tr><th>state</th><th>id</th><th>what</th><th>default or change</th><th>falsifier or check</th>'
      '<th>touches</th></tr></thead><tbody>')
    for x in data["tensions"]:
        mark = ('<span class="state-open">&#9671; open</span>' if x["state"] == "open"
                else '<span class="state-resolved">&#9679; resolved</span>')
        what = x["title"] + ((" (" + x["area"] + ")") if x.get("area") else "")
        if x.get("waits"):
            what += ". Waits: " + x["waits"]
        if x.get("edition"):
            what += ". Edition: " + x["edition"]
        a('<tr><td data-label="state">%s</td><td data-label="id" class="wrap">%s</td><td data-label="what" class="wrap">%s</td>'
          '<td data-label="default or change" class="wrap">%s</td><td data-label="falsifier or check" class="wrap">%s</td>'
          '<td data-label="touches" class="wrap">%s</td></tr>' % (mark, esc(x["id"]), esc(what), esc(x.get("default") or ""),
                                              esc(x.get("falsifier") or ""), esc(", ".join(x["touches"]) or "none found")))
    a("</tbody></table></section>")
    # story
    nodes = {n["id"]: n for n in data["nodes"]}
    out_e, in_e = {}, {}
    for e in data["edges"]:
        out_e.setdefault(e[0], []).append(e)
        in_e.setdefault(e[1], []).append(e)
    a('<section aria-labelledby="h-s"><h2 id="h-s">The story of the drawing</h2><p>Every thing drawn, with its '
      'lines, in words. Open an entry to light it up in the ring.</p>')
    for gid, gname in (("bryant", "Bryant's garden"), ("corwin", "Corwin's garden"), ("platform", "Named from elsewhere")):
        group = [n for n in data["nodes"] if n["garden"] == gid]
        a('<h3>%s (%d)</h3><div class="story-cols">' % (gname, len(group)))
        for n in sorted(group, key=lambda n: (n["kind"], n["name"])):
            bits = []
            if n.get("lane"):
                bits.append(esc(n["lane"]))
            meta = [n["kind"]]
            if n.get("ver"):
                meta.append("version " + str(n["ver"]))
            if n.get("state"):
                meta.append(str(n["state"]))
            if n.get("slot"):
                meta.append("glove slot " + n["slot"])
            if n.get("k"):
                meta.append("makers: " + ", ".join(n["k"]))
            lines = []
            for e in out_e.get(n["id"], []):
                st = e[4].get("state")
                lines.append("%s %s%s" % (e[2], (nodes[e[1]]["name"] if e[1] in nodes else e[1]),
                                          " (%s)" % st if st else ""))
            for e in in_e.get(n["id"], []):
                st = e[4].get("state")
                lines.append("%s from %s%s" % (e[2], (nodes[e[0]]["name"] if e[0] in nodes else e[0]),
                                               " (%s)" % st if st else ""))
            a('<details data-node="%s"><summary>%s <span class="muted">(%s)</span></summary><p class="wrap">%s</p>'
              '<p class="muted wrap">%s</p>%s%s</details>'
              % (esc(n["id"]), esc(n["name"]), esc(n["kind"]), "; ".join(bits) or "", esc("; ".join(meta)),
                 ("<p class=\"wrap\">Lineage: %s</p>" % esc(n["l"])) if n.get("l") else "",
                 ("<p class=\"wrap\">Lines: %s.</p>" % esc("; ".join(lines))) if lines else "<p>No lines.</p>"))
        a("</div>")
    a("</section>")
    a('<section aria-labelledby="h-src"><h2 id="h-src">Sources read for this build</h2><table><thead><tr><th>file</th>'
      '<th>read as</th><th>sha256</th><th>bytes</th></tr></thead><tbody>')
    for s in data["sources"]:
        a('<tr><td class="wrap">%s</td><td>%s</td><td class="wrap">%s</td><td>%s</td></tr>'
          % (esc(s["path"]), esc(s["reader"]), "missing" if s.get("missing") else esc(s["sha256"][:16]),
             "" if s.get("missing") else s["bytes"]))
    a("</tbody></table></section></main>")
    a('<footer><h2>Made together</h2><p>Corwin Brust and Bryant Frankford share these gardens as one collection. '
      'This page\'s code is offered under GPL-3.0-or-later OR LGPL-3.0-or-later and its words under CC-BY-SA-4.0; '
      'text quoted from a skill keeps the terms of that skill. Copyright &copy; 2026 Corwin Brust and Bryant '
      'Frankford, and Contributors.</p>')
    if data.get("masked"):
        mk = data["masked"]
        a('<p>This is the copy for sharing. I masked this machine\'s paths and links and dropped nothing: %d drive '
          'paths, %d msys paths and %d UNC hosts now read like <code>&lt;F&gt;:/claude</code>, and %d claude.ai links '
          'read <code>&lt;claude.ai link&gt;</code>.</p>' % (mk["drive-letter"], mk["msys-path"], mk["unc-path"],
                                                             mk["claude-ai-link"]))
    hw = data["terms"].get("his_words")
    if hw:
        a('<p>In Bryant\'s words: &ldquo;%s&rdquo;</p>' % esc(hw))
    a('<p>The ring\'s shape, the family arcs and the edge types are his; the counterparts, the tensions, the compass '
      'and the doorways are what I added to read the two gardens together.</p>')
    a('<p>Mentat (for Corwin; claude-opus-5-5)</p></footer>')
    js = JS
    blob = canon(data).replace("</", "<\\/")
    a('<script type="application/json" id="garden-data">%s</script>' % blob)
    a("<script>%s</script></body></html>" % js)
    return "\n".join(P) + "\n"


# ---------------------------------------------------------------- main
def main(argv):
    cmd = "build"
    args = list(argv)
    if args and args[0] in ("build", "text", "facts"):
        cmd = args.pop(0)
    if args and args[0] in ("-h", "--help"):
        print(__doc__ or open(__file__).read().split("\nimport ", 1)[0])
        return 0
    opt = {"--root": None, "--c4": None, "--out": None, "--at": None}
    public = False
    while args:
        a = args.pop(0)
        if a == "--public":
            public = True
        elif a in opt and args:
            opt[a] = args.pop(0)
        else:
            die("unknown argument %r (see --help)" % a)
    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    root = os.path.abspath(opt["--root"] or here)
    c4 = opt["--c4"] or os.environ.get("C4_ROOT") or ("/f/claude/c4" if os.path.isdir("/f/claude/c4")
                                                     else os.path.join(os.path.expanduser("~"), "mnt", "c4"))
    built = opt["--at"] or time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    g = Garden(root, os.path.abspath(c4), built)
    data = g.build()
    if cmd == "text":
        sys.stdout.write(words(data))
        return 0
    if cmd == "facts":
        sys.stdout.write(facts(data))
        return 0
    out = os.path.abspath(opt["--out"] or os.path.join(root, "site", "garden"))
    os.makedirs(out, exist_ok=True)

    def write_all(d, where):
        os.makedirs(where, exist_ok=True)

        def w(name, text):
            tmp = os.path.join(where, "." + name + ".tmp")
            with open(tmp, "w", encoding="utf-8", newline="\n") as f:
                f.write(text)
            os.replace(tmp, os.path.join(where, name))
        w("data.json", json.dumps(d, ensure_ascii=False, indent=1) + "\n")
        w("garden-view.facts", facts(d))
        w("pairs.txt", "".join("%s %s\n" % p for p in pairs(LIGHT) + pairs(DARK)))
        w("index.html", page(d))
    write_all(data, out)
    sys.stdout.write(words(data))
    print("gv1mt: wrote %s/{index.html,data.json,garden-view.facts,pairs.txt}" % out)
    if public:
        pd = public_copy(data)
        write_all(pd, os.path.join(out, "public"))
        mk = pd["masked"]
        print("gv1mt: wrote %s/public/ (the copy for sharing): masked %d drive paths, %d msys paths, %d UNC hosts, "
              "%d claude.ai links; nothing dropped" % (out, mk["drive-letter"], mk["msys-path"], mk["unc-path"],
                                                       mk["claude-ai-link"]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
