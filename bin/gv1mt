#!/usr/bin/env python3
# gv1mt -- GARDEN VIEW 1 MINT.  Rebuilds the garden view (site/garden/) from the files as they are now.
#
# The name, read as a guess I make plainly: GV garden view, 1 run-level 1 (reads files, writes only its
# own output folder), MT mint.
#
# usage: gv1mt [build] [--public] [--root DIR] [--c4 DIR] [--out DIR] [--at ISO-TIME]
#        --public also writes OUT/public/, a copy for sharing with this machine's paths and claude.ai
#        links masked (nothing dropped); check it with C4's pb1ck before it travels.
#        gv1mt text  [same options]      the read-back in words, nothing written
#        gv1mt facts [same options]      the facts lines, nothing written
#
# What it reads, at every build (the model is garden-view/data v1, c4 spells/extension/runs/2026-10-10/
# turn2/study/S7-bryant-graph-and-ours.md, Part 3):
#   - Bryant's Nexus Skill Tree data (c4/from-bryant/*/skill-tree.html) and his newest Gauntlet Nexus Map
#     (c4/from-bryant/*/gauntlet-nexus-map*.html);
#   - our skills (skills/*/SKILL.md), soft skills (SOFT-SKILLS/*/SKILL.md, not _archive*), the six servers
#     (dist/vibrobeast/.mcp.json and their source in polygram/mcp/) with their state words;
#   - the persona ledger (advice/*/persona-ledger/LEDGER-*.md, newest);
#   - the option cards (c4 spells/extension/runs/*/cards/INDEX.md, newest) and ERRATA;
#   - conventions/bryant-counterparts.tsv; and the compass guesses in the S8 study.
# What it writes: OUT/data.json, OUT/index.html (one self-contained page), OUT/garden-view.facts (one line
# per thing, for the awk recount in tests/gv1mt-recount.awk) and OUT/pairs.txt (every colour pair the page
# uses, for color-theory's audit).  OUT defaults to site/garden.  Exit 0 built (missing sources are said),
# 2 usage.
#
# Authored by Mentat (for Corwin; claude-opus-5-5).
# Copyright (C) 2026 Corwin Brust <corwin@bru.st> and Contributors.
# SPDX-License-Identifier: GPL-3.0-or-later OR LGPL-3.0-or-later
import glob, hashlib, html, json, math, os, re, sys, time

FORMAT = "garden-view/data v1"
VERSION = "1.0.0"
EDGE_TYPES = ["counterpart", "derived-from", "wraps", "checks", "route", "hand", "use", "slot", "seam",
              "mention", "vs", "dangling", "gap"]
SHOWN = {"counterpart", "derived-from", "wraps", "checks", "route", "hand"}
KINDS = ["skill", "soft", "server", "persona", "external"]
PREFER = ["corwin", "soft", "server", "persona", "bryant", "external", "c4"]


def die(msg, rc=2):
    sys.stderr.write("gv1mt: %s\n" % msg)
    sys.exit(rc)


# ---------------------------------------------------------------- sources
class Sources:
    def __init__(self, root, c4):
        self.root, self.c4, self.rows = root, c4, []

    def label(self, path):
        for base, name in ((self.root, "AS4CE0001"), (self.c4, "c4")):
            if base and path.startswith(base.rstrip("/") + "/"):
                return name + "/" + path[len(base.rstrip("/")) + 1:]
        return path

    def read(self, path, reader, required=False):
        """The text of PATH, recorded with its sha256 and size; None (recorded missing) when unreadable."""
        try:
            with open(path, "rb") as f:
                raw = f.read()
        except OSError:
            self.rows.append({"path": self.label(path), "reader": reader, "missing": True})
            return None
        self.rows.append({"path": self.label(path), "reader": reader, "sha256": hashlib.sha256(raw).hexdigest(),
                          "bytes": len(raw)})
        return raw.decode("utf-8", "replace")


def newest(paths, key=None):
    paths = sorted(paths, key=key) if key else sorted(paths)
    return paths[-1] if paths else None


# ---------------------------------------------------------------- small parsers
def frontmatter(text):
    """A SKILL.md's frontmatter as {key: str, 'metadata': {key: str}}: the YAML subset the garden uses
    (plain, quoted, and >- / | folded values, one nested metadata block)."""
    out = {"metadata": {}}
    if not text.startswith("---"):
        return out
    end = text.find("\n---", 3)
    lines = text[3:end if end > 0 else len(text)].splitlines()
    cur, curmap, ind = None, out, 0
    for ln in lines:
        if not ln.strip():
            continue
        m = re.match(r"^( *)([A-Za-z0-9_.-]+):\s*(.*)$", ln)
        lead = len(ln) - len(ln.lstrip(" "))
        if m and (cur is None or lead <= ind):
            sp, k, v = len(m.group(1)), m.group(2), m.group(3).strip()
            if sp == 0 and k == "metadata" and not v:
                curmap, cur, ind = out["metadata"], None, 0
                continue
            if sp == 0:
                curmap = out
            target = curmap
            if v in (">-", ">", "|", "|-", ">+", "|+"):
                v = ""
            target[k] = unquote(v)
            cur, ind = (target, k), sp
        elif cur is not None:
            t, k = cur
            t[k] = (t[k] + " " + ln.strip()).strip()
    return out


def unquote(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
        v = v[1:-1]
        if v.startswith("'"):
            pass
        v = v.replace('\\"', '"')
    return v


def js_object(text, start):
    """The balanced {...} beginning at TEXT[start], aware of strings."""
    depth, i, q = 0, start, None
    while i < len(text):
        c = text[i]
        if q:
            if c == "\\":
                i += 2
                continue
            if c == q:
                q = None
        elif c in "\"'`":
            q = c
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return text[start:i + 1]
        i += 1
    return None


def md_table(lines):
    rows = []
    for ln in lines:
        if not ln.startswith("|") or re.match(r"^\|[-| :]+\|\s*$", ln):
            continue
        rows.append([c.strip() for c in ln.strip().strip("|").split(" | ")])
    return rows[1:] if rows else []


def first_sentence(s):
    s = re.sub(r"\s+", " ", s or "").strip()
    m = re.match(r"(.+?[.!?])(\s|$)", s)
    return (m.group(1) if m else s)[:240]


# ---------------------------------------------------------------- the model
class Garden:
    def __init__(self, root, c4, built):
        self.root, self.c4 = root, c4
        self.src = Sources(root, c4)
        self.nodes, self.edges, self.tensions, self.families = {}, {}, [], []
        self.people = 0
        self.words = []
        self.built = built
        self.compass = {"axes": {}, "points": [], "source": None}
        self.doorways = []

    # nodes and edges
    def node(self, kind, garden, prefix, name, **kw):
        nid = "%s:%s" % (prefix, name)
        n = self.nodes.get(nid)
        if n is None:
            n = {"id": nid, "kind": kind, "garden": garden, "name": name, "fam": None, "ver": None, "upd": None,
                 "lane": None, "desc": None, "triggers": [], "ships": [], "slot": None, "k": [], "l": None,
                 "notes": [], "vs": [], "sha256": None, "file": None, "state": None, "seen_in": []}
            self.nodes[nid] = n
        for k, v in kw.items():
            if v in (None, "", [], "?"):
                continue
            if k == "seen_in":
                if v not in n["seen_in"]:
                    n["seen_in"].append(v)
            elif n.get(k) in (None, "", []):
                n[k] = v
        return n

    def edge(self, a, b, typ, label="", **extra):
        if not a or not b or a == b:
            return
        key = (a, b, typ)
        e = self.edges.get(key)
        if e:
            e[4]["times"] = e[4].get("times", 1) + 1
            return
        x = {k: v for k, v in extra.items() if v not in (None, "")}
        x.setdefault("times", 1)
        self.edges[key] = [a, b, typ, label, x]

    def by_name(self, name, prefer=PREFER):
        for p in prefer:
            nid = "%s:%s" % (p, name)
            if nid in self.nodes:
                return nid
        return None

    # ------------------------------------------------ Bryant's garden
    def read_bryant(self):
        fb = os.path.join(self.c4, "from-bryant")
        tree = newest(glob.glob(os.path.join(fb, "*", "skill-tree.html")))
        nexus = newest(glob.glob(os.path.join(fb, "*", "gauntlet-nexus-map*.html")),
                       key=lambda p: os.path.basename(os.path.dirname(p)))
        if not tree:
            self.src.rows.append({"path": "c4/from-bryant/*/skill-tree.html", "reader": "skill-tree", "missing": True})
        if not nexus:
            self.src.rows.append({"path": "c4/from-bryant/*/gauntlet-nexus-map*.html", "reader": "nexus-map",
                                  "missing": True})
        self.bryant_tree = self.bryant_nexus = None
        if tree:
            t = self.src.read(tree, "skill-tree")
            m = t and re.search(r'^<script type="application/json" id="skill-data">(.*?)</script>', t, re.S | re.M)
            if m:
                d = json.loads(m.group(1))
                self.bryant_tree = {"built": d.get("built"), "file": self.src.label(tree)}
                for f in d.get("families", []):
                    self.families.append({"id": f["id"], "name": f.get("name"), "slot": f.get("slot"),
                                          "blurb": f.get("blurb"), "garden": "bryant"})
                for s in d.get("skills", []):
                    self.node("skill" if s.get("src") != "missing" else "external", "bryant", "bryant", s["id"],
                              fam=s.get("fam"), ver=s.get("ver"), upd=s.get("upd"), lane=s.get("lane"),
                              desc=s.get("desc"), triggers=s.get("triggers"), ships=s.get("ships"),
                              notes=s.get("notes"), vs=s.get("vs"), seen_in="skill-tree",
                              state="ghost" if s.get("src") == "missing" else "installed")
                for e in d.get("edges", []):
                    a, b, typ = e[0], e[1], e[2]
                    lab = e[3] if len(e) > 3 else ""
                    self.pending_his.append(("bryant:" + a, b, typ, lab))
                for s in d.get("skills", []):
                    for v in s.get("vs", []) or []:
                        self.pending_his.append(("bryant:" + s["id"], v, "vs", "lane boundary"))
        if nexus:
            t = self.src.read(nexus, "nexus-map")
            i = t.find("const DATA = ") if t else -1
            obj = js_object(t, t.index("{", i)) if i >= 0 else None
            if obj:
                d = json.loads(obj)
                self.bryant_nexus = {"date": d.get("date"), "file": self.src.label(nexus), "terms": d.get("terms")}
                for s in d.get("skills", []):
                    n = self.node("skill", "bryant", "bryant", s["n"], ver=s.get("v"), desc=s.get("d"),
                                  slot=s.get("slot"), k=s.get("k"), l=s.get("l"), ships=s.get("f"),
                                  seen_in="nexus-map", state="installed",
                                  fam=("nexus:" + s["sec"]) if s.get("sec") else None)
                    if s.get("v") and s.get("v") != "?":
                        n["ver"] = s["v"]          # the newer drop's version wins
                    if s.get("k"):
                        n["k"] = s["k"]
                    for mname in s.get("m", []) or []:
                        self.pending_his.append(("bryant:" + s["n"], mname, "mention", "named in his map"))
                    for mname in s.get("not", []) or []:
                        self.pending_his.append(("bryant:" + s["n"], mname, "vs", "says it is not"))
                self.bryant_external = d.get("external", [])

    # ------------------------------------------------ our garden
    def read_ours(self):
        for kind, prefix, pat in (("skill", "corwin", "skills/*/SKILL.md"), ("soft", "soft", "SOFT-SKILLS/*/SKILL.md")):
            for p in sorted(glob.glob(os.path.join(self.root, pat))):
                folder = os.path.basename(os.path.dirname(p))
                if folder.startswith("_"):
                    continue
                t = self.src.read(p, kind)
                if t is None:
                    continue
                fm = frontmatter(t)
                md = fm.get("metadata", {})
                name = fm.get("name") or folder
                ver = md.get("version") or fm.get("version")
                if not ver:
                    m = re.search(r"\bv(\d+\.\d+(?:\.\d+)?)\b", t[:1500])
                    ver = m.group(1) if m else None
                author = md.get("author") or fm.get("author")
                n = self.node(kind, "corwin", prefix, folder, desc=fm.get("description"),
                              lane=first_sentence(fm.get("description")), ver=ver,
                              k=[author] if author else None, l=md.get("derived-from"),
                              file=self.src.label(p), sha256=self.src.rows[-1]["sha256"],
                              state="installed" if kind == "skill" else "soft", fam="ours" if kind == "skill" else "soft",
                              seen_in=pat.split("/")[0])
                if name != folder:
                    n["notes"].append({"lvl": "info", "text": "frontmatter name %r differs from folder" % name})
                self.ours_text[n["id"]] = t
                notice = os.path.join(os.path.dirname(p), "NOTICE.md")
                if os.path.exists(notice):
                    nt = self.src.read(notice, "notice")
                    self.notices[n["id"]] = nt or ""

    def read_servers(self):
        mcp = os.path.join(self.root, "dist", "vibrobeast", ".mcp.json")
        t = self.src.read(mcp, "mcp.json")
        names = list(json.loads(t).get("mcpServers", {}).keys()) if t else []
        prefs_t = self.src.read(os.path.join(self.root, "polygram", "mcp", "prefs.py"), "prefs") or ""
        defaults = dict(re.findall(r'^\s*"([a-z0-9]+\.on)":\s*\("([a-z]+)"', prefs_t, re.M))
        for name in names:
            mod = os.path.join(self.root, "polygram", "mcp", name + ".py")
            text = self.src.read(mod, "server") or ""
            tools, seen, todo = [], set(), [(mod, text)]
            # one level of the package modules it imports
            for m in re.finditer(r"from \. import ([a-z_, ]+)|from \.([a-z_]+) import", text):
                for imp in (m.group(1) or m.group(2)).split(","):
                    imp = imp.strip()
                    f = os.path.join(self.root, "polygram", "mcp", imp + ".py")
                    if imp and os.path.exists(f) and f not in seen:
                        seen.add(f)
                        try:
                            todo.append((f, open(f, encoding="utf-8").read()))
                        except OSError:
                            pass
            for f, tx in todo:
                for tn in re.findall(r'@srv\.tool\(\s*"([^"]+)"', tx):
                    if tn not in tools:
                        tools.append(tn)
            words = []
            for w in re.findall(r'"state":\s*"([^"]+)"', text):
                if w not in words:
                    words.append(w)
            gate = None
            m = re.search(r'_pref\("([a-z0-9]+\.on)"\)', text) or re.search(r"pref_set ([a-z0-9]+\.on) on", text)
            if m:
                gate = m.group(1)
            if gate:
                state = "gated"
                says = ("%s by default (preference %s); this build cannot see your setting, because your "
                        "preferences live outside what the build reads" % (defaults.get(gate, "off"), gate))
            else:
                state = "installed"
                says = "on whenever the plugin runs"
            n = self.node("server", "corwin", "server", name, file=self.src.label(mod), state=state,
                          lane=says, ver=(re.search(r'^VERSION = "([^"]+)"', text, re.M) or [None, None])[1],
                          fam="server", seen_in="mcp.json")
            n["tools"] = tools
            n["state_words"] = words
            n["gate"] = gate
            n["notes"].append({"lvl": "info", "text": "tools source-read, not asked"})
        # what each server wraps
        if "server:llamabridge" in self.nodes:
            tgt = self.by_name("llama-bridge", ["bryant"]) or self.node("external", "bryant", "external", "llama-bridge")["id"]
            self.edge("server:llamabridge", tgt, "wraps", "serves Bryant's Llama Bridge code (NOTICE-llama_bridge)",
                      cite="polygram/mcp/NOTICE-llama_bridge")
        if "server:tavernface" in self.nodes:
            tv = self.node("external", "bryant", "external", "tavern", lane="Bryant's Tavern 2.3.1, kept byte for byte",
                           k=["Bryant Frankford"], fam="external")
            self.edge("server:tavernface", tv["id"], "wraps", "serves Tavern 2.3.1 byte for byte (NOTICE-tavern)",
                      cite="polygram/mcp/NOTICE-tavern")
        if "server:c4face" in self.nodes:
            c4m = self.node("external", "corwin", "c4", "c4-mcp.js", lane="C4's own MCP server (c4/mcp/c4-mcp.js)",
                            k=["Corwin Brust"], fam="external")
            self.edge("server:c4face", c4m["id"], "wraps", "runs C4's own c4-mcp.js", cite="polygram/mcp/c4face.py")

    def read_ledger(self):
        led = newest(glob.glob(os.path.join(self.root, "advice", "*", "persona-ledger", "LEDGER-*.md")),
                     key=os.path.getmtime)
        if not led:
            self.src.rows.append({"path": "advice/*/persona-ledger/LEDGER-*.md", "reader": "ledger", "missing": True})
            return
        t = self.src.read(led, "ledger") or ""
        sec = re.split(r"^## ", t, flags=re.M)
        part = {s.split("\n", 1)[0].strip(): s for s in sec}

        def body(prefix):
            for k, v in part.items():
                if k.startswith(prefix):
                    return v.splitlines()
            return []
        for r in md_table(body("Sheets")):
            if len(r) < 6:
                continue
            self.node("persona", "corwin", "persona", r[0], ver=r[2], sha256=r[3], file=r[5], fam="persona",
                      state=r[1], seen_in="ledger")
            self.nodes["persona:" + r[0]]["actor"] = r[1]
        m = re.search(r"\((\d+)\) person models?", t) or re.search(r"\b(\d+) person models?", t)
        self.people = int(m.group(1)) if m else 0
        for state, prefix in (("sheet", "Edges in the sheets"), ("proposed", "Proposed by review")):
            for r in md_table(body(prefix)):
                if len(r) < 4:
                    continue
                a, b = r[0], r[1]
                withheld = "person model" in a or "person model" in b
                fa = "people" if "person model" in a else "persona:" + a
                fb = "people" if "person model" in b else "persona:" + b
                self.edge(fa, fb, "checks", "can falsify" if not withheld else "withheld: a person model is at one end",
                          state="withheld" if withheld else state, cite=r[3])
        self.ledger_file = self.src.label(led)

    # ------------------------------------------------ resolution of names into edges
    def resolve_pending(self):
        for a, bname, typ, lab in self.pending_his:
            tgt = self.by_name(bname, ["bryant", "corwin", "soft", "server", "persona", "external"])
            if typ == "dangling":
                self.edge(a, tgt or "missing:" + bname, "dangling", lab, state="dangling" if not tgt else "resolved")
                continue
            if tgt is None:
                tgt = self.node("external", "platform", "external", bname, fam="external", state="named")["id"]
            self.edge(a, tgt, typ, lab, cite=(self.bryant_nexus or {}).get("file") if typ in ("mention",) else
                      (self.bryant_tree or {}).get("file"))
        # his map's "external" list: a name of ours points at our node (his mentions already reach it); a name
        # already in his garden stays his; anything else is named from elsewhere.
        self.his_externals_ours = []
        for ex in getattr(self, "bryant_external", []):
            nm = ex.get("n")
            ours = self.by_name(nm, ["corwin", "soft"])
            if ours:
                self.his_externals_ours.append(nm)
                self.nodes[ours]["notes"].append({"lvl": "info", "text": "Bryant's Gauntlet Nexus Map lists this "
                                                  "among its externals: %s" % (ex.get("note") or "no note")})
            elif "bryant:" + nm not in self.nodes:
                self.node("external", "platform", "external", nm, lane=ex.get("note"), fam="external", state="named")

    def counterparts(self):
        tsv = os.path.join(self.root, "conventions", "bryant-counterparts.tsv")
        t = self.src.read(tsv, "counterparts") or ""
        listed = set()
        for ln in t.splitlines():
            if ln.startswith("#") or not ln.strip():
                continue
            c = ln.split("\t")
            if len(c) < 5:
                continue
            his, our, place, rel, why = c[:5]
            if our == "-" or rel == "none":
                continue
            hid = self.by_name(his, ["bryant"]) or self.node("external", "bryant", "bryant", his, fam="external",
                                                             state="named")["id"]
            if place.startswith("SOFT-SKILLS"):
                oid = "soft:" + our
            elif place.startswith("c4"):
                oid = self.node("external", "corwin", "c4", our, lane="in C4's %s" % place, fam="external")["id"]
            else:
                oid = "corwin:" + our
            if oid not in self.nodes:
                oid = self.by_name(our, ["corwin", "soft"]) or oid
            if oid not in self.nodes:
                continue
            listed.add((hid, oid))
            cite = "conventions/bryant-counterparts.tsv"
            if rel == "derived-from-his":
                self.edge(oid, hid, "derived-from", "ours, from his: " + why, cite=cite)
            elif rel == "derived-from-ours":
                self.edge(hid, oid, "derived-from", "his, from ours: " + why, cite=cite)
            else:
                self.edge(hid, oid, "counterpart", rel.replace("-", " ") + ": " + why, cite=cite)
        for nid, n in list(self.nodes.items()):
            if n["garden"] != "bryant" or n["kind"] not in ("skill", "external"):
                continue
            for p, lab in (("corwin", "same name"), ("soft", "carried soft")):
                oid = "%s:%s" % (p, n["name"])
                if oid in self.nodes and (nid, oid) not in listed:
                    self.edge(nid, oid, "counterpart", lab, cite="by name")

    def our_text_edges(self):
        names = sorted({n["name"] for n in self.nodes.values() if n["kind"] in ("skill", "soft")}, key=len, reverse=True)
        for nid, t in self.ours_text.items():
            body = t
            for m in re.finditer(r"(?:routes?|hands?(?: off)?|hand-off)\s+(?:it\s+)?to\s+`?([a-z][a-z0-9-]+)`?", body):
                tgt = self.by_name(m.group(1), ["corwin", "soft", "bryant"])
                if tgt and tgt != nid:
                    self.edge(nid, tgt, "route", "says it routes to it", cite=self.nodes[nid]["file"])
            for m in re.finditer(r"\bNOT\s+`?([a-z][a-z0-9-]{3,})`?", body):
                tgt = self.by_name(m.group(1), ["corwin", "soft", "bryant"])
                if tgt and tgt != nid:
                    self.edge(nid, tgt, "vs", "says it is NOT this", cite=self.nodes[nid]["file"])
            for nm in names:
                if nm == self.nodes[nid]["name"] or ("-" not in nm and len(nm) < 6):
                    continue
                if re.search(r"(?<![a-z0-9-])%s(?![a-z0-9-])" % re.escape(nm), body):
                    tgt = self.by_name(nm, ["corwin", "soft"])
                    if tgt:
                        self.edge(nid, tgt, "mention", "named in its text", cite=self.nodes[nid]["file"])
            d = self.nodes[nid].get("l")
            if d:
                m = re.match(r"\s*([a-z][a-z0-9-]+)", d)
                if m:
                    tgt = self.by_name(m.group(1), ["bryant", "corwin", "soft"]) or self.node(
                        "external", "bryant", "bryant", m.group(1), fam="external", state="named")["id"]
                    self.edge(nid, tgt, "derived-from", "metadata.derived-from", cite=self.nodes[nid]["file"])
        for nid, nt in self.notices.items():
            his = self.by_name(self.nodes[nid]["name"], ["bryant"])
            if his and ("byte for byte" in nt or "Bryant" in nt):
                self.edge(nid, his, "derived-from", "kept whole, with NOTICE.md", cite=self.nodes[nid]["file"]
                          .replace("SKILL.md", "NOTICE.md"))

    # ------------------------------------------------ tensions
    def read_tensions(self):
        idx = newest(glob.glob(os.path.join(self.c4, "spells", "extension", "runs", "*", "cards", "INDEX.md")))
        names = {}
        for n in self.nodes.values():
            if n["kind"] in ("skill", "soft", "server", "persona") and ("-" in n["name"] or len(n["name"]) >= 5):
                names.setdefault(n["name"], self.by_name(n["name"]))

        def touches(text):
            out = []
            for nm, nid in names.items():
                if nid and re.search(r"(?<![A-Za-z0-9-])%s(?![A-Za-z0-9-])" % re.escape(nm), text):
                    out.append(nid)
            return sorted(set(out))
        if not idx:
            self.src.rows.append({"path": "c4/spells/extension/runs/*/cards/INDEX.md", "reader": "cards", "missing": True})
        else:
            t = self.src.read(idx, "cards") or ""
            lines = t.splitlines()
            for i, ln in enumerate(lines, 1):
                m = re.match(r"^\| (\d\d) \| \[([^\]]+)\]\(([^)]+)\) \| (.*?) \| (.*?) \| (.*?) \| (.*?) \|\s*$", ln)
                if not m:
                    continue
                nn, slug, f, area, default, rule, edition = m.groups()
                cf = os.path.join(os.path.dirname(idx), f)
                ct = self.src.read(cf, "card") or ""
                fm = re.search(r"\*\*Falsifier\.\*\*\s*(.+)", ct)
                rule_main = re.match(r"(\w+)", rule).group(1)
                ed = edition.strip().strip("`")
                self.tensions.append({
                    "id": "card:" + nn, "src": "card", "ref": os.path.splitext(f)[0], "title": slug,
                    "area": area, "rule": rule_main, "rule_note": rule if rule != rule_main else None,
                    "default": default, "edition": ed, "state": "resolved" if ed.startswith("this") else "open",
                    "waits": None, "falsifier": fm.group(1).strip() if fm else None, "touches": touches(ct),
                    "cite": "%s:%d" % (self.src.label(idx), i)})
        er = os.path.join(self.root, "ERRATA")
        t = self.src.read(er, "errata")
        if t:
            cur, key = None, None
            for i, ln in enumerate(t.splitlines(), 1):
                m = re.match(r"^\* (E\d+)\s+(.*)$", ln)
                if m:
                    cur = {"id": "errata:" + m.group(1), "src": "errata", "ref": m.group(1), "title": m.group(2).strip(),
                           "area": None, "rule": None, "rule_note": None, "default": None, "edition": None,
                           "state": "open", "waits": None, "falsifier": None, "touches": [], "_text": ln,
                           "cite": "AS4CE0001/ERRATA:%d" % i}
                    self.tensions.append(cur)
                    key = None
                    continue
                if cur is None:
                    continue
                cur["_text"] += "\n" + ln
                km = re.match(r"^\s+(Where|Why it waits|Change[^:]*|Check|Observed[^:]*):\s*(.*)$", ln)
                if km:
                    key = {"Where": "area", "Why it waits": "waits", "Check": "falsifier"}.get(km.group(1))
                    if key is None and km.group(1).startswith("Change"):
                        key = "default"
                    if key:
                        cur[key] = km.group(2).strip()
                elif key and ln.startswith("         ") and ln.strip():
                    cur[key] = (cur[key] + " " + ln.strip()).strip()
                else:
                    key = None
            for x in self.tensions:
                if x["src"] == "errata":
                    x["touches"] = touches(x.pop("_text"))

    # ------------------------------------------------ the compass (S8 section 3)
    def read_compass(self):
        s8 = newest(glob.glob(os.path.join(self.c4, "spells", "extension", "runs", "*", "turn2", "study", "S8-*.md")))
        self.compass["axes"] = {
            "x": {"west": "Accessibility", "east": "Interoperability"},
            "y": {"north": "capability as imagination, own-ness and freedom of use",
                  "south": "conventionality, intuitiveness, custom and boundary as signage"}}
        if not s8:
            self.src.rows.append({"path": "c4/spells/extension/runs/*/turn2/study/S8-*.md", "reader": "compass",
                                  "missing": True})
            return
        t = self.src.read(s8, "compass") or ""
        sec = t.split("## 3. The axes", 1)
        if len(sec) < 2:
            return
        body = sec[1].split("\n## ", 1)[0]
        garden = None
        for ln in body.splitlines():
            if ln.startswith("### Ours"):
                garden = "corwin"
            elif ln.startswith("### Bryant"):
                garden = "bryant"
            m = re.match(r"^\| (.+?) \| ([-+]?\d+) \| ([-+]?\d+) \| ([0-9.]+) / (\w+) \| (.*) \|\s*$", ln)
            if m and garden:
                label = re.sub(r"\s*\(`[^)]*`\)", "", m.group(1)).replace("`", "").strip()
                node = None
                for cand in re.findall(r"[a-z][a-z0-9-]+", label.lower()):
                    node = node or self.by_name(cand, ["corwin", "soft", "bryant"] if garden == "corwin"
                                                else ["bryant", "corwin", "soft"])
                self.compass["points"].append({"label": label, "garden": garden, "x": int(m.group(2)),
                                               "y": int(m.group(3)), "L": float(m.group(4)), "C": m.group(5),
                                               "saw": m.group(6).replace("`", ""), "node": node})
        self.compass["source"] = self.src.label(s8)

