def pairs(theme):
    t = theme
    out = [(t["ink"], t["bg"]), (t["muted"], t["bg"]), (t["link"], t["bg"]), (t["ink"], t["panel"]),
           (t["muted"], t["panel"]), (t["link"], t["panel"]), (t["his"], t["bg"]), (t["ours"], t["bg"]),
           (t["open"], t["bg"]), (t["resolved"], t["bg"]), (t["open"], t["panel"]), (t["resolved"], t["panel"]),
           (t["focus"], t["bg"]), (t["line"], t["bg"]), (t["his"], t["panel"]), (t["ours"], t["panel"])]
    out += [(t["e-" + k], t["bg"]) for k in EDGE_TYPES]
    return out


def esc(s):
    return html.escape(str(s if s is not None else ""), quote=True)


def polar(r, deg):
    a = math.radians(deg)
    return r * math.cos(a), r * math.sin(a)


def layout(data):
    """Positions: his garden on the left half-ring, ours on the right, servers and personas inside."""
    pos = {}
    nodes = {n["id"]: n for n in data["nodes"]}
    fam_order = [f["id"] for f in data["families"] if f.get("garden") == "bryant"]
    his = [n for n in data["nodes"] if n["garden"] == "bryant" and n["kind"] in ("skill", "external")
           and n["name"] not in ("alfred", "power-glove", "omni-tool", "gauntlet")]
    his.sort(key=lambda n: (fam_order.index(n["fam"]) if n["fam"] in fam_order else 99, n["fam"] or "~", n["name"]))
    R = 410
    for i, n in enumerate(his):
        pos[n["id"]] = (R, 97 + 166 * (i + 0.5) / max(1, len(his)))
    for i, nm in enumerate(["power-glove", "omni-tool", "gauntlet"]):
        if "bryant:" + nm in nodes:
            pos["bryant:" + nm] = (165, 150 + 30 * i)
    if "bryant:alfred" in nodes:
        pos["bryant:alfred"] = (70, 180)
    # ours: counterparts mirrored, then the rest
    cp = {}
    for e in data["edges"]:
        if e[2] in ("counterpart", "derived-from"):
            a, b = e[0], e[1]
            h, o = (a, b) if a.startswith("bryant:") else (b, a)
            if h in pos and o in nodes and nodes[o]["garden"] == "corwin":
                cp.setdefault(o, pos[h][1])
    ours = [n for n in data["nodes"] if n["kind"] in ("skill", "soft") and n["garden"] == "corwin"]
    ours += [n for n in data["nodes"] if n["kind"] == "external" and n["garden"] == "corwin"]
    ours.sort(key=lambda n: (0 if n["id"] in cp else 1, -(180 - cp[n["id"]]) if n["id"] in cp else 0,
                             n["kind"], n["name"]))
    # mirrored angle of 97..263 is 83..-83: largest first runs top to bottom on the right
    ours.sort(key=lambda n: ((180 - cp[n["id"]]) if n["id"] in cp else 999, n["kind"], n["name"]))
    with_cp = [n for n in ours if n["id"] in cp]
    rest = [n for n in ours if n["id"] not in cp]
    seq = sorted(with_cp, key=lambda n: -((180 - cp[n["id"]] + 180) % 360 - 180)) + rest
    seq = list(reversed(sorted(with_cp, key=lambda n: (180 - cp[n["id"]])))) + rest
    for i, n in enumerate(seq):
        pos[n["id"]] = (R, -83 + 166 * (i + 0.5) / max(1, len(seq)))
    rest = [n for n in data["nodes"] if n["id"] not in pos and n["kind"] not in ("server", "persona")]
    for i, n in enumerate(rest):
        pos[n["id"]] = (265, 115 + 130 * (i + 0.5) / max(1, len(rest)) if n["garden"] != "corwin"
                        else -65 + 130 * (i + 0.5) / max(1, len(rest)))
    out = {k: polar(*v) + (v[1],) for k, v in pos.items()}
    # servers and personas inside, in two columns of their own, labels to the right (swing 1: no overlaps)
    for col, kind, step in ((30, "persona", 24), (175, "server", 40)):
        group = [n for n in data["nodes"] if n["kind"] == kind]
        top = -step * (len(group) - 1) / 2.0
        for i, n in enumerate(group):
            x, y = col, top + step * i
            out[n["id"]] = (x, y, math.degrees(math.atan2(y, x)))
    return out


def spread(items, gap):
    """1-D label placement: ITEMS [(desired, key)] -> {key: position}, each at least GAP from the next,
    as close as it can be to where it wants to be (blocks merged while they collide)."""
    items = sorted(items)
    blocks = []                                   # [first index, count, sum of (desired - offset)]
    for i, (d, k) in enumerate(items):
        blocks.append([i, 1, d])
        while len(blocks) > 1:
            b1, b2 = blocks[-2], blocks[-1]
            if b1[2] / b1[1] + b1[1] * gap <= b2[2] / b2[1]:
                break
            b1[2] += b2[2] - b2[1] * b1[1] * gap
            b1[1] += b2[1]
            blocks.pop()
    out = {}
    for s0, n, sm in blocks:
        x0 = sm / n
        for j in range(n):
            out[items[s0 + j][1]] = x0 + j * gap
    return out


def shape(n, x, y):
    k = n["kind"]
    if k == "soft":
        return '<rect x="%.1f" y="%.1f" width="9" height="9"/>' % (x - 4.5, y - 4.5)
    if k == "server":
        return '<polygon points="%.1f,%.1f %.1f,%.1f %.1f,%.1f %.1f,%.1f"/>' % (x, y - 7, x + 7, y, x, y + 7, x - 7, y)
    if k == "persona":
        return '<polygon points="%.1f,%.1f %.1f,%.1f %.1f,%.1f"/>' % (x, y - 6, x + 6, y + 5, x - 6, y + 5)
    if k == "external":
        return '<circle cx="%.1f" cy="%.1f" r="4" class="hollow"/>' % (x, y)
    return '<circle cx="%.1f" cy="%.1f" r="5"/>' % (x, y)


def ring_svg(data):
    P = layout(data)
    nodes = {n["id"]: n for n in data["nodes"]}
    out = ['<svg id="ring" viewBox="-660 -600 1320 1200" role="img" aria-labelledby="ring-t ring-d" '
           'xmlns="http://www.w3.org/2000/svg">',
           '<title id="ring-t">Two gardens, one ring</title>',
           '<desc id="ring-d">Bryant\'s garden on the left half, ours on the right, servers and personas inside; '
           'lines are the links listed in the story below, marks on the inner band are the tensions.</desc>',
           '<text class="garden-label his" x="-560" y="-560">Bryant\'s garden</text>',
           '<text class="garden-label ours" x="400" y="-560">Corwin\'s garden</text>',
           '<g class="edges">']
    for e in data["edges"]:
        a, b, t = e[0], e[1], e[2]
        if a not in P or b not in P:
            continue
        x1, y1, _ = P[a]
        x2, y2, _ = P[b]
        cx, cy = (x1 + x2) * 0.18, (y1 + y2) * 0.18
        st = e[4].get("state")
        cls = "e e-%s%s%s" % (t, "" if t in SHOWN else " off", " proposed" if st in ("proposed",) else "")
        out.append('<path class="%s" data-a="%s" data-b="%s" d="M%.1f %.1fQ%.1f %.1f %.1f %.1f"/>'
                   % (cls, esc(a), esc(b), x1, y1, cx, cy, x2, y2))
    out.append("</g><g class=\"nodes\">")
    for nid, (x, y, deg) in sorted(P.items()):
        n = nodes[nid]
        side = "his" if n["garden"] in ("bryant", "platform") else "ours"
        out.append('<g class="n %s k-%s" data-id="%s">%s' % (side, n["kind"], esc(nid), shape(n, x, y)))
        if n["kind"] in ("server", "persona"):
            out.append('<text x="%.1f" y="%.1f" dominant-baseline="middle">%s</text>' % (x + 10, y, esc(n["name"])))
        elif math.hypot(x, y) > 380:
            lx, ly = polar(math.hypot(x, y) + 10, deg)
            rot = deg if -90 <= deg <= 90 else deg - 180
            anchor = "start" if -90 <= deg <= 90 else "end"
            out.append('<text x="%.1f" y="%.1f" transform="rotate(%.1f %.1f %.1f)" text-anchor="%s" '
                       'dominant-baseline="middle">%s</text>' % (lx, ly, rot, lx, ly, anchor, esc(n["name"])))
        else:
            out.append('<text x="%.1f" y="%.1f" text-anchor="middle">%s</text>' % (x, y - 9, esc(n["name"])))
        out.append("</g>")
    out.append("</g><g class=\"tensions\">")
    # tensions on a track of their own (r=340, inside our ring, outside the inner columns), each at the
    # mean angle of what it touches, spread so no two labels meet; labels run outward, like the ring's.
    want = []
    for i, x in enumerate(data["tensions"]):
        degs = [P[t][2] for t in x["touches"] if t in P]
        if degs:
            sx = sum(math.cos(math.radians(d)) for d in degs)
            sy = sum(math.sin(math.radians(d)) for d in degs)
            deg = math.degrees(math.atan2(sy, sx)) if (abs(sx) + abs(sy)) > 1e-9 else -90.0
        else:
            deg = -90.0
        want.append((deg, i))
    at = spread(want, 2.4)
    TR = 338
    out.append('<circle class="track" cx="0" cy="0" r="%d"/>' % TR)
    for i, x in enumerate(data["tensions"]):
        deg = at[i]
        px, py = polar(TR, deg)
        lab = x["ref"] if x["src"] == "errata" else x["id"].split(":")[1]
        g = ('<circle cx="%.1f" cy="%.1f" r="5" class="t-resolved"/>' % (px, py) if x["state"] == "resolved" else
             '<polygon class="t-open" points="%.1f,%.1f %.1f,%.1f %.1f,%.1f %.1f,%.1f"/>'
             % (px, py - 6, px + 6, py, px, py + 6, px - 6, py))
        lx, ly = polar(TR + 9, deg)
        d2 = ((deg + 180) % 360) - 180
        rot = d2 if -90 <= d2 <= 90 else d2 - 180
        anchor = "start" if -90 <= d2 <= 90 else "end"
        out.append('<g class="t %s" data-t="%s">%s<text x="%.1f" y="%.1f" transform="rotate(%.1f %.1f %.1f)" '
                   'text-anchor="%s" dominant-baseline="middle" class="tlab">%s %s</text></g>'
                   % (x["state"], esc(x["id"]), g, lx, ly, rot, lx, ly, anchor, esc(lab), x["state"]))
    out.append("</g></svg>")
    return "\n".join(out)


def compass_svg(data):
    pts = data["compass"]["points"]
    S = 62
    out = ['<svg id="compass" viewBox="-250 -200 500 400" role="img" aria-labelledby="cmp-t cmp-d" '
           'xmlns="http://www.w3.org/2000/svg">', '<title id="cmp-t">The compass</title>',
           '<desc id="cmp-d">West accessibility, east interoperability; north imagination and own-ness, south '
           'convention and signage. Every placement is a guess; the table beside it gives each likelihood and '
           'confidence.</desc>',
           '<line class="axis" x1="-170" y1="0" x2="170" y2="0"/><line class="axis" x1="0" y1="-160" x2="0" y2="160"/>',
           '<text x="-246" y="-8">Accessibility</text><text x="246" y="-8" text-anchor="end">Interoperability</text>',
           '<text x="8" y="-172">Imagination, own-ness</text>',
           '<text x="8" y="182">Convention, signage</text>']
    seen = {}
    for i, p in enumerate(pts, 1):
        key = (p["x"], p["y"])
        k = seen.get(key, 0)
        seen[key] = k + 1
        x, y = p["x"] * S + (k % 3) * 30, -p["y"] * S + (k // 3) * 18
        if p["garden"] == "bryant":
            g = '<rect class="his" x="%.1f" y="%.1f" width="9" height="9"/>' % (x - 4.5, y - 4.5)
        else:
            g = '<circle class="ours" cx="%.1f" cy="%.1f" r="5"/>' % (x, y)
        out.append('%s<text x="%.1f" y="%.1f" class="clab">%d</text>' % (g, x + 7, y + 4, i))
    out.append("</svg>")
    return "\n".join(out)


def tokens_css(t):
    return ";".join("--%s:%s" % (k, v) for k, v in t.items())


