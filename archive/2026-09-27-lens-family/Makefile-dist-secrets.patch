 # RELEASE=X.Y.Z names the version instead of z+1 (rl2bp start --to): make dist RELEASE=0.8.50
 RELEASE  ?=
 dist:
+	@# Secrets at this boundary (Corwin 2026-09-26): what ships is scanned before anything is minted.
+	@# C4's sb1rn: one of two checkers at random, the other confirms a hit; never prints the secret.
+	@if [ -f $(C4_ROOT)/bin/sb1rn ]; then sh $(C4_ROOT)/bin/sb1rn skills bin polygram $(wildcard $(CANON)) || { \
+	  echo "make dist: secret-shaped text in what would ship (above). Fix it, or mark a documentation line sb:allow."; exit 1; }; \
+	else echo "make dist: sb1rn not found under $(C4_ROOT)/bin -- secrets NOT checked"; fi
 	sh bin/rl2bp start $(if $(RELEASE),--to $(RELEASE),)
 	@if [ "$(UNSIGNED)" = 1 ]; then \
 	  echo "make dist: UNSIGNED=1 -- express manifests only (no key used)"; \
