        cfg = json.loads((self.unpacked / ".mcp.json").read_text(encoding="utf-8"))["mcpServers"]
        self.assertEqual(sorted(cfg), ["mentcached", "persona", "skillx"])
        for name, sdef in cfg.items():
            self.assertEqual(sdef["env"]["PYTHONPATH"],
