                        .read_text(encoding="utf-8"))
        self.assertEqual(mf["name"], "vibrobeast")
        self.assertEqual(mf["license"], "GPL-3.0-or-later")
        self.assertEqual(mf["mcpServers"], "./.mcp.json")

